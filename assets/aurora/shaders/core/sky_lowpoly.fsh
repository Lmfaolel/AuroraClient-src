#version 150

// Low Poly sky. Generated by tools/skylab/port.js from tools/skylab/styles/lowpoly.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    float u_facetSize;
    float u_jitter;
    float u_shading;
    float u_edges;
    vec4 c_edgeColor;
    vec4 c_dayTop;
    vec4 c_dayHorizon;
    vec4 c_sunsetTop;
    vec4 c_sunsetHorizon;
    vec4 c_nightTop;
    vec4 c_nightHorizon;
    float u_sunOn;
    float u_sunSize;
    float u_sides;
    vec4 c_sunColor;
    vec4 c_moonColor;
    float u_cloudOn;
    float u_cloudAmount;
    float u_wind;
    vec4 c_cloudColor;
    vec4 c_cloudShade;
    float u_starsOn;
    float u_starDensity;
};
#define u_edgeColor c_edgeColor.rgb
#define u_dayTop c_dayTop.rgb
#define u_dayHorizon c_dayHorizon.rgb
#define u_sunsetTop c_sunsetTop.rgb
#define u_sunsetHorizon c_sunsetHorizon.rgb
#define u_nightTop c_nightTop.rgb
#define u_nightHorizon c_nightHorizon.rgb
#define u_sunColor c_sunColor.rgb
#define u_moonColor c_moonColor.rgb
#define u_cloudColor c_cloudColor.rgb
#define u_cloudShade c_cloudShade.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

vec2 frame(vec3 d, vec3 s){ vec3 e1=normalize(cross(s,vec3(0.,1.,0.))), e2=cross(e1,s); return vec2(dot(d,e1),dot(d,e2)); }
vec3 dirOf(vec2 p){ float q=dot(p,p); return vec3(2.*p.x,1.-q,2.*p.y)/(1.+q); }

// the mesh lives on the sky seen from straight below (stereographic from the nadir): a grid with its corners
// jittered, each square cut corner to corner, so the triangles are pinned to the dome and their edges stay straight
vec2 vtx(vec2 v){ return v+(h22(v)-.5)*u_jitter*.0065; }
float cross2(vec2 a, vec2 b){ return a.x*b.y-a.y*b.x; }
// signed distance inside the triangle (positive inside), and its id
float tri(vec2 p, vec2 a, vec2 b, vec2 c){
  float s=sign(cross2(b-a,c-a));
  vec2 e0=b-a, e1=c-b, e2=a-c;
  float d0=cross2(e0,p-a)/length(e0), d1=cross2(e1,p-b)/length(e1), d2=cross2(e2,p-c)/length(e2);
  return min(min(d0,d1),d2)*s;
}

float cloudAt(vec3 d){
  if(d.y<.03) return -1.;
  vec2 p=d.xz/(d.y+.2)*.8+vec2(uTime*u_wind*.0004,0.);
  return fbm(p)-mix(.76,.42,u_cloudAmount*.01);
}

vec3 sky(vec3 d){
  vec3 s=sunDir();
  float day=dayF(), dusk=duskF(), night=smoothstep(.5,.95,1.-day);
  float cs=radians(u_facetSize);
  vec2 p=d.xz/(1.+max(d.y,-.9)), q=p/cs, ci=floor(q);
  float best=-9., tid=0.;
  vec2 ta=vec2(0.), tb=vec2(0.), tc=vec2(0.);
  for(int j=-1;j<=1;j++) for(int i=-1;i<=1;i++){
    vec2 c=ci+vec2(float(i),float(j));
    vec2 a=vtx(c), b=vtx(c+vec2(1.,0.)), e=vtx(c+vec2(1.,1.)), f=vtx(c+vec2(0.,1.));
    bool flip=h21(c+7.)>.5;
    vec2 x0=a, x1=b, x2=flip?f:e, y0=flip?b:a, y1=e, y2=f;
    float d1=tri(q,x0,x1,x2), d2=tri(q,y0,y1,y2);
    if(d1>best){ best=d1; tid=dot(c,vec2(1.,157.))*2.; ta=x0; tb=x1; tc=x2; }
    if(d2>best){ best=d2; tid=dot(c,vec2(1.,157.))*2.+1.; ta=y0; tb=y1; tc=y2; }
  }
  vec3 dc=dirOf((ta+tb+tc)/3.*cs);
  float h=h11(tid);
  float y=max(dc.y,0.);

  vec3 top=mix(u_nightTop,u_dayTop,day), hor=mix(u_nightHorizon,u_dayHorizon,day);
  top=mix(top,u_sunsetTop,dusk*.7);
  hor=mix(hor,u_sunsetHorizon,dusk*(.3+.7*pow(sunSide(dc),2.)));
  vec3 c=mix(hor,top,smoothstep(0.,.85,pow(y,.7)));
  // each facet tilted a little: brighter on the side facing the sun
  float lit=(h-.5)+.5*dot(normalize(dc+(h22(vec2(tid,1.))-.5).xyx*.6),s)*max(day,dusk);
  c*=1.+lit*u_shading*.006;

  if(u_cloudOn>.5){
    float n=cloudAt(dc);
    if(n>0.){
      float n2=cloudAt(normalize(dc+vec3(0.,.04,0.)));
      vec3 cc=mix(u_cloudShade,u_cloudColor,smoothstep(-.02,.06,n2-n+.03)*.7+h*.3);
      cc=mix(cc*vec3(.3,.34,.55),cc,max(day,dusk*.8));
      cc=mix(cc,cc*vec3(1.,.8,.7)+u_sunsetHorizon*.25,dusk*.6);
      c=cc;
    }
  }
  float cloudy=u_cloudOn>.5?step(0.,cloudAt(dc)):0.;

  if(u_starsOn>.5 && night>.01 && cloudy<.5){
    float el=elev(d);
    vec2 sq=vec2(atan(d.z,d.x)*cos(el),el)*22., sc=floor(sq);
    // drawn round the star's own direction: the grid's x shears with height away from one side of the sky
    vec2 qc=(sc+.5+(h22(sc)-.5)*.6)/22.;
    float sa=qc.x/max(cos(qc.y),.05);
    vec2 f=frame(d,vec3(cos(qc.y)*cos(sa),sin(qc.y),cos(qc.y)*sin(sa)));
    float r=(1.5+2.*h21(sc+2.))*SC*PX, tw=.7+.3*sin(uTime*2.+h21(sc)*30.);
    float on=step(1.-u_starDensity*.004,h21(sc+5.));
    float dia=abs(f.x)+abs(f.y);
    c=mix(c,mix(vec3(1.),vec3(.8,.9,1.),step(0.,f.x*f.y)),(1.-smoothstep(r-PX,r,dia))*on*tw*night*smoothstep(.03,.12,d.y));
  }

  if(u_sunOn>.5 && cloudy<.5){
    // a gem cut sun: a polygon fanned into triangles, each shaded on its own
    float R=radians(u_sunSize)*.5, a=angTo(d,s), up=smoothstep(-.1,.03,s.y);
    if(up>0. && dot(d,s)>.6){
      vec2 l=frame(d,s);
      float th=atan(l.y,l.x), seg=TAU/u_sides, k=floor(th/seg);
      float rr=length(l)*cos(mod(th,seg)-seg*.5)/cos(seg*.5);
      float inner=step(rr,R*.55);
      vec3 sc=mix(u_sunColor,u_sunColor*vec3(1.,.6,.4),dusk*.6);
      vec3 fc=sc*(1.+(h11(k+inner*20.)-.5)*u_shading*.006+inner*.12);
      c=mix(c,fc,(1.-smoothstep(R-PX,R,rr))*up);
      c+=sc*exp(-a/R*1.4)*.25*up*max(day,dusk);
    }
    vec3 m=-s; float ma=angTo(d,m), mup=smoothstep(-.1,.03,m.y), MR=radians(u_sunSize)*.35;
    if(mup>0. && dot(d,m)>.7){
      vec2 l=frame(d,m);
      float th=atan(l.y,l.x), seg=TAU/10., k=floor(th/seg);
      float rr=length(l)*cos(mod(th,seg)-seg*.5)/cos(seg*.5);
      vec2 o=l-vec2(MR*.42,MR*.12);
      float th2=atan(o.y,o.x), rr2=length(o)*cos(mod(th2,seg)-seg*.5)/cos(seg*.5);
      float m1=(1.-smoothstep(MR-PX,MR,rr))*smoothstep(MR*.88-PX,MR*.88,rr2);
      c=mix(c,u_moonColor*(1.+(h11(k+3.)-.5)*u_shading*.005),m1*mup);
    }
  }

  // edges: the distance to the triangle's own sides, in pixels
  float k=cs*2./(1.+dot(p,p))/PX;
  c=mix(c,u_edgeColor,(1.-smoothstep(.4*SC,1.3*SC,best*k))*u_edges*.01*smoothstep(-.02,.05,d.y));
  return c;
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
