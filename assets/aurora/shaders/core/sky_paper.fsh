#version 150

// Paper Cutout sky. Generated by tools/skylab/port.js from tools/skylab/styles/paper.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    float u_bands;
    float u_waveHeight;
    float u_waveCount;
    float u_sheetVar;
    float u_grain;
    float u_fibres;
    float u_fuzz;
    float u_shadow;
    float u_shadowSoft;
    float u_edgeLight;
    vec4 c_dayTop;
    vec4 c_dayHorizon;
    vec4 c_duskHorizon;
    vec4 c_nightTop;
    vec4 c_nightHorizon;
    float u_sunOn;
    float u_sunSize;
    float u_rays;
    float u_rayLength;
    vec4 c_sunCore;
    vec4 c_sunRay;
    float u_moonOn;
    float u_moonSize;
    float u_moonPhase;
    vec4 c_moonColor;
    float u_cloudOn;
    float u_cloudLayers;
    float u_cloudAmount;
    float u_cloudSize;
    float u_wind;
    vec4 c_cloudFront;
    vec4 c_cloudBack;
    float u_starsOn;
    float u_paperStars;
    float u_starDensity;
    vec4 c_starColor;
    float u_stringsOn;
    vec4 c_stringColor;
};
#define u_dayTop c_dayTop.rgb
#define u_dayHorizon c_dayHorizon.rgb
#define u_duskHorizon c_duskHorizon.rgb
#define u_nightTop c_nightTop.rgb
#define u_nightHorizon c_nightHorizon.rgb
#define u_sunCore c_sunCore.rgb
#define u_sunRay c_sunRay.rgb
#define u_moonColor c_moonColor.rgb
#define u_cloudFront c_cloudFront.rgb
#define u_cloudBack c_cloudBack.rgb
#define u_starColor c_starColor.rgb
#define u_stringColor c_stringColor.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

float wrapA(float a){ return mod(a+PI,TAU)-PI; }
vec2 frame(vec3 d, vec3 s){ vec3 e1=normalize(cross(s,vec3(0.,1.,0.))), e2=cross(e1,s); return vec2(dot(d,e1),dot(d,e2)); }
// drop shadows fall down and a little right, further when stronger
vec2 soff(){ return vec2(.45,-1.)*(.0015+.005*u_shadow*.01); }
float sw(){ return .002+u_shadowSoft*.01*.02; }
float shade(float sd){ return u_shadow*.01*.5*(1.-smoothstep(-sw()*.3,sw(),sd)); }
// felt: edges wobble at the pixel scale
float fz(vec2 q){ return u_fuzz>0.?(vnoise(q*.35)-.5)*u_fuzz*.01*3.5*PX:0.; }

// grain, fibres and a slight per-sheet tint, stuck to the sky so they don't swim when you turn
vec3 paperTex(vec3 c, vec2 q, float id){
  c*=1.+(h11(id*7.13+.5)-.5)*u_sheetVar*.004;
  float g=(vnoise(q*.9+id*13.1)-.5)+(vnoise(q*.31+id*3.7)-.5)*.7;
  c*=1.+g*u_grain*.0016;
  vec2 r=vec2(q.x*.8+q.y*.6,-q.x*.6+q.y*.8);
  // light and dark flecks, the way real paper has both
  float f=pow(vnoise(vec2(r.x*.25,r.y*1.1)+id*5.3),9.)-pow(vnoise(vec2(r.y*.25,r.x*1.1)+id*2.9),9.)*.7;
  return c*(1.+f*u_fibres*.0035);
}

// one sky sheet: covers everything below its cut edge, casts a soft shadow just above it. the colour is left flat and
// id says which sheet is on top, so a stack is textured once rather than once per sheet
void sheet(inout vec3 c, inout float id, float k, float az, float el, vec2 tq, vec3 top, vec3 hor){
  float n=u_bands, z=k/max(n-1.,1.);
  // fixed to the sky: shifting sheets with the camera slid the whole background as you looked round
  float x=az, y=el;
  float t=k/n;
  float b=1.3*pow(1.-t,1.4);
  float amp=u_waveHeight*.01*.075*(.35+.65*t), wc=u_waveCount, s=h11(k*3.7)*TAU;
  b+=amp*(sin(x*wc+s)*.55+sin(x*wc*2.17+s*1.3)*.25+(vnoise(vec2(x*wc*1.3,k*4.))-.5)*.45);
  float dist=b-y+fz(tq+k*20.);
  c*=1.-u_shadow*.01*.5*(1.-smoothstep(0.,sw()*2.5,-dist));
  vec3 col=mix(top,hor,z)+u_edgeLight*.01*.14*(1.-smoothstep(0.,2.5*PX,dist));
  float a=smoothstep(-PX*.7,PX*.7,dist);
  c=mix(c,col,a);
  if(a>.5) id=k;
}

// a paper cloud: puffs along the top, cut flat along the bottom. p is (azimuth, elevation)
float cloudSD(vec2 p, float l){
  float cnt=12., w=TAU/cnt, i0=floor(p.x/w), best=1.;
  float sz=.55+u_cloudSize*.011;
  for(int k=-1;k<=1;k++){
    float i=i0+float(k), im=mod(i,cnt);
    float h=h11(im*1.7+l*19.);
    if(h>u_cloudAmount*.01) continue;
    float h2=h11(im*5.3+l*7.), h3=h11(im*9.1+l*3.);
    float cx=(i+.5+(h2-.5)*.45)*w;
    float W=(.075+.065*h3)*sz;
    float base=.13+.15*l+(h2-.5)*.05;
    float dx=(p.x-cx)*cos(base), sd=1.;
    for(int j=0;j<5;j++){
      float fj=float(j);
      float r=W*(.22+.2*sin(PI*(fj+.5)/5.)+.08*h11(fj+im*3.+l));
      sd=min(sd,length(vec2(dx,p.y-base)-vec2(W*(fj/4.-.5)*1.45,r*.5))-r);
    }
    best=min(best,max(sd,base-p.y));
  }
  return best;
}

void clouds(inout vec3 c, float az, float el, vec2 tq, float day, float dusk){
  if(u_cloudOn<.5) return;
  for(int li=2;li>=0;li--){
    float l=float(li);
    if(l>u_cloudLayers-.5) continue;
    float z=.6-.2*l;
    float drift=uTime*u_wind*.0003*(1.+.6*(2.-l));
    vec2 p=vec2(az+drift, el);
    float sd=cloudSD(p,l);
    // nothing of this layer reaches here, not even its shadow
    if(sd>length(soff())+sw()+PX*4.) continue;
    sd+=fz(tq+l*40.);
    c*=1.-shade(cloudSD(p-soff(),l));
    vec3 col=mix(u_cloudFront,u_cloudBack,l*.5);
    col=mix(col*vec3(.32,.36,.55),col,day);
    col=mix(col,col*vec3(1.05,.8,.72)+u_duskHorizon*.22,dusk*.65);
    col=paperTex(col,tq,30.+l);
    col+=u_edgeLight*.01*.12*(1.-smoothstep(0.,2.5*PX,-sd));
    c=mix(c,col,1.-smoothstep(-PX*.7,PX*.7,sd));
  }
}

// a string from an object straight up, the way a mobile hangs
void string(inout vec3 c, float az, float el, vec3 o, float len){
  if(u_stringsOn<.5) return;
  float ao=atan(o.z,o.x), eo=elev(o);
  float dx=abs(wrapA(az-ao))*cos(el);
  float a=(1.-smoothstep(PX*.4,PX*1.3,dx))*step(eo,el)*step(el,eo+len);
  c=mix(c,u_stringColor,a*.9);
}

void sun(inout vec3 c, vec3 d, float az, float el, vec2 tq, float dusk){
  vec3 S=sunDir();
  if(u_sunOn<.5) return;
  float R=radians(u_sunSize)*.5;
  if(S.y>-.05) string(c,az,el,S,1.6);
  if(dot(d,S)<.6) return;
  vec2 l=frame(d,S);
  vec3 core=mix(u_sunCore,u_sunCore*vec3(1.,.72,.5)+vec3(.12,0.,0.),dusk*.6);
  vec3 ray=mix(u_sunRay,u_sunRay*vec3(1.,.6,.45)+vec3(.1,0.,0.),dusk*.6);
  float spin=uTime*.04;
  if(u_rays>.5){
    vec2 ls=l-soff();
    float tri=1.-abs(fract((atan(ls.y,ls.x)+spin)/TAU*u_rays)*2.-1.);
    c*=1.-shade(length(ls)-R*(1.12+u_rayLength*.01*.95*tri));
    tri=1.-abs(fract((atan(l.y,l.x)+spin)/TAU*u_rays)*2.-1.);
    float sd=length(l)-R*(1.12+u_rayLength*.01*.95*tri)+fz(tq+7.);
    vec3 col=paperTex(ray,tq,50.)+u_edgeLight*.01*.12*(1.-smoothstep(0.,2.5*PX,-sd));
    c=mix(c,col,1.-smoothstep(-PX*.7,PX*.7,sd));
  }
  c*=1.-shade(length(l-soff()*.7)-R);
  float sd=length(l)-R+fz(tq+9.);
  vec3 col=paperTex(core,tq,51.)+u_edgeLight*.01*.14*(1.-smoothstep(0.,2.5*PX,-sd));
  c=mix(c,col,1.-smoothstep(-PX*.7,PX*.7,sd));
}

void moon(inout vec3 c, vec3 d, float az, float el, vec2 tq, float day){
  vec3 M=-sunDir();
  if(u_moonOn<.5) return;
  float R=radians(u_moonSize)*.5, off=mix(.38,2.2,u_moonPhase*.01)*R;
  if(M.y>-.05) string(c,az,el,M,1.6);
  if(dot(d,M)<.7) return;
  vec2 l=frame(d,M);
  // a crescent: the disc minus a second disc slid sideways
  vec2 ls=l-soff();
  c*=1.-shade(max(length(ls)-R,R-length(ls-vec2(off,0.))))*mix(1.,.4,day);
  float sd=max(length(l)-R,R-length(l-vec2(off,0.)))+fz(tq+11.);
  vec3 col=paperTex(u_moonColor*mix(1.,.92,day),tq,52.)+u_edgeLight*.01*.12*(1.-smoothstep(0.,2.5*PX,-sd));
  c=mix(c,col,(1.-smoothstep(-PX*.7,PX*.7,sd))*mix(1.,.85,day));
}

// iq's five-point star
float star5(vec2 p, float r, float rf){
  const vec2 k1=vec2(.809016994375,-.587785252292);
  const vec2 k2=vec2(-.809016994375,-.587785252292);
  p.x=abs(p.x);
  p-=2.*max(dot(k1,p),0.)*k1;
  p-=2.*max(dot(k2,p),0.)*k2;
  p.x=abs(p.x);
  p.y-=r;
  vec2 ba=rf*vec2(-k1.y,k1.x)-vec2(0.,1.);
  float h=clamp(dot(p,ba)/dot(ba,ba),0.,r);
  return length(p-ba*h)*sign(p.y*ba.x-p.x*ba.y);
}

// stars sit in rings of cells, each ring holding as many cells as fit round it, so they stay round everywhere.
// gives the cell id and the star's (azimuth, elevation)
void starAt(float row, float az, float K, out vec2 cid, out vec2 ctr){
  float n=max(floor(TAU*cos((row+.5)/K)*K),1.);
  float ac=floor((az+PI)/TAU*n);
  cid=vec2(ac,row);
  vec2 o=(h22(cid+3.)-.5)*.45;
  ctr=vec2((ac+.5+o.x)/n*TAU-PI,(row+.5+o.y)/K);
}

void starsLayer(inout vec3 c, float az, float el, vec2 tq, float night){
  if(u_starsOn<.5||night<.02||el<.12) return;
  bool paper=u_paperStars>.5;
  float K=paper?13.:32., thr=u_starDensity*.01*(paper?.5:.7);
  float x=wrapA(az), row=floor(el*K);
  float fade=night*smoothstep(.12,.22,el);
  vec2 cid, ctr;
  // about half the paper stars hang from a string, up to three rows tall
  if(paper&&u_stringsOn>.5){
    for(int j=0;j<4;j++){
      starAt(row-float(j),x,K,cid,ctr);
      if(h21(cid)>thr||h21(cid+11.)>.5) continue;
      float up=el-ctr.y;
      float a=(1.-smoothstep(PX*.3,PX*1.1,abs(wrapA(x-ctr.x))*cos(el)))*step(.012,up)*(1.-smoothstep(2.,3.2,up*K));
      c=mix(c,u_stringColor,a*.85*fade);
    }
  }
  starAt(row,x,K,cid,ctr);
  if(h21(cid)>thr) return;
  vec2 p=vec2(wrapA(x-ctr.x)*cos(el),el-ctr.y);
  float tw=.75+.25*sin(uTime*(1.+2.*h21(cid+9.))+h21(cid)*40.);
  if(paper){
    float r=.012+.007*h21(cid+5.);
    float ang=(h21(cid+7.)-.5)*.6+sin(uTime*.8+h21(cid)*20.)*.08*u_stringsOn;
    mat2 m=mat2(cos(ang),-sin(ang),sin(ang),cos(ang));
    c*=1.-shade(star5(m*(p-soff()),r,.45))*fade;
    float sd=star5(m*p,r,.45)+fz(tq+13.);
    vec3 col=paperTex(u_starColor,tq,60.)+u_edgeLight*.01*.15*(1.-smoothstep(0.,2.5*PX,-sd));
    c=mix(c,col,(1.-smoothstep(-PX*.7,PX*.7,sd))*fade);
  }else{
    // a hole punched through the card, lit from behind
    float r=.0022+.0028*h21(cid+5.), dd=length(p);
    float hole=1.-smoothstep(r-PX*.6,r+PX*.6,dd);
    c+=u_starColor*exp(-max(dd-r,0.)/(r*1.4))*.3*tw*fade*(1.-hole);
    c=mix(c,u_starColor*(1.05+.25*tw),hole*fade);
  }
}

vec3 sky(vec3 d){
  float day=dayF(), dusk=duskF();
  float az=atan(d.z,d.x), el=elev(d);
  vec3 top=mix(u_nightTop,u_dayTop,day);
  vec3 hor=mix(u_nightHorizon,u_dayHorizon,day);
  hor=mix(hor,u_duskHorizon,dusk*.85);
  top=mix(top,mix(top,u_duskHorizon,.35),dusk*.55);
  vec2 tq=d.xz/(1.+max(d.y,-.5))/PX;
  vec3 c=top;
  float id=-1.;
  // far sheets, then what hangs in the sky, then the nearest sheet in front of it all
  for(int i=0;i<8;i++){ float k=float(i); if(k>u_bands-1.5) break; sheet(c,id,k,az,el,tq,top,hor); }
  c=paperTex(c,tq,id);
  // stars come out once the sun is down, not while the sunset is still lit
  starsLayer(c,az,el,tq,smoothstep(.5,.95,1.-day));
  moon(c,d,az,el,tq,day);
  sun(c,d,az,el,tq,dusk);
  clouds(c,az,el,tq,day,dusk);
  float front=-1.;
  sheet(c,front,u_bands-1.,az,el,tq,top,hor);
  if(front>=0.) c=paperTex(c,tq,front);
  return c;
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
