#version 150

// Stained Glass sky. Generated by tools/skylab/port.js from tools/skylab/styles/glass.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    float u_paneSize;
    float u_lead;
    vec4 c_leadColor;
    float u_saturation;
    float u_variation;
    float u_texture;
    float u_glow;
    vec4 c_dayTop;
    vec4 c_dayHorizon;
    vec4 c_sunsetTop;
    vec4 c_sunsetHorizon;
    vec4 c_nightTop;
    vec4 c_nightHorizon;
    float u_sunOn;
    float u_sunSize;
    float u_petals;
    vec4 c_sunColor;
    vec4 c_sunAccent;
    vec4 c_moonColor;
    float u_cloudOn;
    float u_cloudAmount;
    float u_wind;
    vec4 c_cloudColor;
    float u_starsOn;
    float u_starDensity;
    vec4 c_starColor;
};
#define u_leadColor c_leadColor.rgb
#define u_dayTop c_dayTop.rgb
#define u_dayHorizon c_dayHorizon.rgb
#define u_sunsetTop c_sunsetTop.rgb
#define u_sunsetHorizon c_sunsetHorizon.rgb
#define u_nightTop c_nightTop.rgb
#define u_nightHorizon c_nightHorizon.rgb
#define u_sunColor c_sunColor.rgb
#define u_sunAccent c_sunAccent.rgb
#define u_moonColor c_moonColor.rgb
#define u_cloudColor c_cloudColor.rgb
#define u_starColor c_starColor.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

vec2 frame(vec3 d, vec3 s){ vec3 e1=normalize(cross(s,vec3(0.,1.,0.))), e2=cross(e1,s); return vec2(dot(d,e1),dot(d,e2)); }
vec3 dirOf(vec2 p){ float q=dot(p,p); return vec3(2.*p.x,1.-q,2.*p.y)/(1.+q); }
vec3 sat(vec3 c, float k){ float l=dot(c,vec3(.3,.59,.11)); return max(mix(vec3(l),c,k),0.); }

float cloudAt(vec3 d){
  if(d.y<.03) return 0.;
  vec2 p=d.xz/(d.y+.2)*.9+vec2(uTime*u_wind*.0004,0.);
  return step(mix(.78,.42,u_cloudAmount*.01),fbm(p));
}

vec3 paneCol(vec3 ds, float h, float day, float dusk){
  float y=max(ds.y,0.);
  vec3 top=mix(u_nightTop,u_dayTop,day), hor=mix(u_nightHorizon,u_dayHorizon,day);
  top=mix(top,u_sunsetTop,dusk*.7);
  hor=mix(hor,u_sunsetHorizon,dusk*(.3+.7*pow(sunSide(ds),2.)));
  vec3 c=mix(hor,top,smoothstep(0.,.8,pow(y,.7)));
  // each pane a slightly different batch of glass
  c*=1.+(h-.5)*u_variation*.009;
  c=mix(c,c.gbr*.4+c*.7,(fract(h*7.3)-.5)*u_variation*.006);
  return sat(c,u_saturation*.01);
}

vec3 sky(vec3 d){
  vec3 s=sunDir();
  float day=dayF(), dusk=duskF(), night=smoothstep(.5,.95,1.-day);
  float cs=radians(u_paneSize);
  vec2 p=d.xz/(1.+max(d.y,-.9)), q=p/cs;
  // pixels per unit of q, for lead widths in pixels: the stereographic map stretches by 2/(1+|p|^2)
  float k=cs*2./(1.+dot(p,p))/PX;

  // voronoi panes, then the distance to the nearest lead line (iq's border distance)
  vec2 qi=floor(q), qf=fract(q), mr=vec2(0.), mc=vec2(0.);
  float md=8.;
  for(int j=-1;j<=1;j++) for(int i=-1;i<=1;i++){
    vec2 g=vec2(float(i),float(j)), r=g+.1+.8*h22(qi+g)-qf;
    float dd=dot(r,r);
    if(dd<md){ md=dd; mr=r; mc=qi+g; }
  }
  float edge=8.;
  for(int j=-2;j<=2;j++) for(int i=-2;i<=2;i++){
    vec2 g=vec2(float(i),float(j)), r=g+.1+.8*h22(qi+g)-qf;
    if(dot(mr-r,mr-r)>1e-5) edge=min(edge,dot(.5*(mr+r),normalize(r-mr)));
  }
  float h=h21(mc);
  vec3 ds=dirOf((mc+.1+.8*h22(mc))*cs);
  vec3 c=paneCol(ds,h,day,dusk);
  float cloud=u_cloudOn>.5?cloudAt(ds):0.;
  vec3 cg=u_cloudColor*(1.+(h-.5)*.12);
  c=mix(c,cg*mix(vec3(.25,.28,.45),vec3(1.),max(day,dusk*.8)),cloud);
  // the window is lit from outside, so the panes darken at night but the moon and starlight stay bright
  c*=mix(.6,1.,max(day,dusk*.85));
  float leadPx=edge*k;

  if(u_starsOn>.5 && cloud<.5 && night>.01){
    // starlight: a few panes carry a chip of clear glass that the stars shine through
    float st=step(h,u_starDensity*.006)*night*smoothstep(.04,.15,d.y);
    vec2 cp=(mc+.1+.8*h22(mc)+(h22(mc+3.)-.5)*.3);
    float r=length(q-cp)*k;
    c=mix(c,u_starColor*(.8+.2*sin(uTime*2.+h*40.)),(1.-smoothstep(1.5*SC,2.5*SC,r))*st);
    c+=u_starColor*exp(-r/(4.*SC))*.25*st;
  }

  if(u_sunOn>.5 && cloud<.5){
    float R=radians(u_sunSize)*.5, a=angTo(d,s), up=smoothstep(-.1,.04,s.y);
    if(up>0. && a<R*1.05){
      // rose window: a centre disc, a ring of petals, an outer ring, all leaded
      vec2 l=frame(d,s)/R;
      float r=length(l), th=atan(l.y,l.x)/TAU*u_petals, pk=floor(th), pf=fract(th)-.5;
      float petal=r-(.62+.33*cos(pf*PI*1.3));
      vec3 gold=sat(mix(u_sunColor,vec3(1.,.55,.2),dusk*.5),u_saturation*.01);
      vec3 acc=sat(u_sunAccent,u_saturation*.01);
      vec3 rc=r<.3?gold*1.2:(petal<0.?mix(gold,acc,step(.5,fract(pk*.5))):mix(acc,gold*.8,.4));
      float lead=min(min(abs(r-.3),abs(r-1.)),min(abs(petal)*.6,r>.3&&petal<0.?abs(pf)*TAU/u_petals*r:9.));
      c=mix(c,rc,up*step(r,1.));
      leadPx=mix(leadPx,lead*R/PX,up*step(r,1.03));
    }
    vec3 m=-s; float ma=angTo(d,m), mup=smoothstep(-.1,.04,m.y), MR=R*.45;
    if(mup>0. && ma<MR*1.1){
      vec2 l=frame(d,m)/MR;
      float sd=length(l-vec2(.55,.1))-.85;
      vec3 mc2=sat(u_moonColor,u_saturation*.01);
      c=mix(c,sd>0.?mc2:mc2*.35+u_nightTop*.4,mup*step(length(l),1.));
      leadPx=mix(leadPx,min(abs(length(l)-1.),max(abs(sd),length(l)-1.))*MR/PX,mup*step(length(l),1.05));
    }
  }

  // light through the glass: brighter round the sun, streaks and seeds in the glass, darker where it meets the lead
  float a=angTo(d,s);
  c*=1.+u_glow*.012*exp(-a*3.)*max(day,dusk)*smoothstep(-.1,.05,s.y);
  vec2 sq=mat2(cos(h*6.),sin(h*6.),-sin(h*6.),cos(h*6.))*q;
  float tx=vnoise(sq*vec2(14.,2.5)+h*50.)-.5;
  tx+=step(.93,h21(floor(sq*30.)+h))*.6;
  c*=1.+tx*u_texture*.005;
  c*=.72+.28*smoothstep(0.,6.*SC,leadPx);
  float lw=u_lead*SC;
  return mix(c,u_leadColor,1.-smoothstep(lw*.5,lw*.5+1.,leadPx));
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
