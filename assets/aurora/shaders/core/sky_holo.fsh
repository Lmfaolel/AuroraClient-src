#version 150

// Holographic sky. Generated by tools/skylab/port.js from tools/skylab/styles/holo.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    float u_finish;
    vec4 c_tint1;
    vec4 c_tint2;
    float u_sheen;
    float u_flow;
    float u_viewShift;
    float u_sunOn;
    float u_sunSize;
    float u_corona;
    float u_halo;
    float u_rainbowOn;
    float u_rainbowStrength;
    float u_cloudsOn;
    float u_cloudCover;
    float u_cloudEdge;
    vec4 c_cloudTint;
    float u_bubblesOn;
    float u_bubbleCount;
    float u_bubbleSize;
    float u_facetsOn;
    float u_facetSize;
    float u_facetBend;
    float u_glitterOn;
    float u_glitterAmount;
    vec4 c_nightColor;
    float u_starAmount;
    float u_auroraOn;
    float u_auroraStrength;
    float u_auroraHeight;
};
#define u_tint1 c_tint1.rgb
#define u_tint2 c_tint2.rgb
#define u_cloudTint c_cloudTint.rgb
#define u_nightColor c_nightColor.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

// thin-film interference: thickness -> the soap-bubble rainbow
vec3 film(float t){ return .5+.5*cos(TAU*(t*vec3(1.,.86,.72)+vec3(0.,.12,.26))); }
vec3 hue(float t){ return .5+.5*cos(TAU*(t+vec3(0.,.33,.67))); }
vec3 spectrum(float x){ return clamp(vec3(1.5-abs(x*2.-.4)*2.2, 1.5-abs(x*2.)*2.2, 1.5-abs(x*2.+.4)*2.2),0.,1.); }
// keeps a colour at full brightness: foil mixes of opposite hues go pastel instead of brown
vec3 bright(vec3 c, float k){ return c/(max(max(c.r,c.g),c.b)+.001)*k; }
// the colours sweep across the sky, fixed to it: tied to where you looked, the whole sky changed colour as you turned
float viewPh(vec3 d){ return ((d.x*.7-d.z*.5)+d.y*.5)*1.6*u_viewShift; }
float glint(vec3 d){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el),el)*70.;
  vec2 c=floor(q), f=fract(q)-.5;
  float h=h21(c);
  f-=(h22(c)-.5)*.5;
  float tw=pow(.5+.5*sin(uTime*(1.5+h*3.)+h*40.),6.);
  float cr=exp(-abs(f.x)*55.)*exp(-abs(f.y)*7.)+exp(-abs(f.y)*55.)*exp(-abs(f.x)*7.);
  return step(.95-u_glitterAmount*.2,h)*cr*tw;
}
vec4 shard(vec2 p){
  vec2 i=floor(p), f=fract(p); float F1=8., F2=8.; vec2 id=vec2(0.);
  for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++){
    vec2 g=vec2(float(x),float(y)); vec2 o=.5+.42*sin(TAU*h22(i+g)+uTime*.03);
    vec2 r=g+o-f; float dd=dot(r,r);
    if(dd<F1){ F2=F1; F1=dd; id=i+g; } else if(dd<F2) F2=dd;
  }
  return vec4(sqrt(F1),sqrt(F2),id);
}
vec3 sky(vec3 d0){
  vec3 s=sunDir(); float day=dayF(), dusk=duskF();
  float flow=uTime*(.015+.07*u_flow), V=viewPh(d0);
  bool pearl=u_finish>.5&&u_finish<1.5, oil=u_finish>1.5;
  // facets: each one bends the view a little, everything below is seen through it
  vec3 d=d0; float facet=0., fid=0.;
  if(u_facetsOn>.5){
    float K=mix(8.,2.5,u_facetSize);
    vec4 v=shard(d0.xz/(abs(d0.y)+.6)*K+vec2(0.,d0.y*2.));
    vec3 off=vec3(h21(v.zw)-.5,(h21(v.zw+4.)-.5)*.5,h21(v.zw+9.)-.5)*.4*u_facetBend;
    d=normalize(d0+off*smoothstep(-.05,.1,d0.y));
    facet=1.-smoothstep(0.,.025+PX*K*1.5,v.y-v.x);
    fid=h21(v.zw+2.);
  }
  float y=max(d.y,0.);
  float n=fbm(d.xz/(d.y+.35)*1.1+vec2(flow,-flow*.6));
  float ph=n*1.6+y*.9+V+flow*.4+fid*.7;
  vec3 iri=film(ph);
  vec3 tint=mix(u_tint1,u_tint2,.5+.5*sin(ph*PI));
  float sh=u_sheen;

  // ---- day: the foil itself
  vec3 dayC;
  if(pearl) dayC=mix(vec3(.94,.93,.97),mix(tint,iri,.4),.12+.3*sh+.14*n);
  else if(oil){
    vec2 op=d.xz/(d.y+.35)*1.4;
    vec2 wq=vec2(fbm(op+flow),fbm(op*1.3+5.2-flow));
    float n2=fbm(op*1.6+wq*1.8);
    float sw=smoothstep(.4,.98,.5+.5*sin(n2*16.+V*3.));
    dayC=mix(mix(u_tint1*.22,u_tint2*.38,y)+.02,mix(film(n2*3.+V+flow),vec3(.4),.3)*.85,sw*(.3+.6*sh));
  } else dayC=bright(mix(mix(tint,iri,sh),vec3(1.),.3),.97);
  dayC+=pow(.5+.5*sin(n*7.+y*5.+V*4.),10.)*(oil?.12:.2);
  dayC=mix(dayC,mix(vec3(1.),film(ph+.3),.25),exp(-y*9.)*(oil?.15:.35));
  // ---- dusk: the film warms to peach and lilac
  vec3 duskC=mix(vec3(1.,.62,.6),vec3(.6,.48,.95),pow(y,.5));
  duskC=mix(duskC,iri,(oil?.45:.28)*(.5+sh))*(oil?.6:1.);
  duskC+=vec3(1.,.7,.5)*pow(sunSide(d),3.)*exp(-y*5.)*.35;
  // ---- night: deep violet, aurora ribbons in film colours, glitter stars
  vec3 nightC=mix(u_nightColor*.55,u_nightColor*.1,pow(y,.6))+iri*.04;
  float ax=atan(d.z,d.x), el=elev(d);
  vec2 ring=normalize(d.xz+1e-5);
  if(u_auroraOn>.5){
    for(int i=0;i<3;i++){
      float fi=float(i);
      float ce=.18+.35*u_auroraHeight+.13*fi+.07*sin(ax*2.+fi*1.7+uTime*.08)+.05*vnoise(ring*1.5+vec2(fi*5.,uTime*.05));
      float w=.05+.04*vnoise(ring*3.+vec2(fi,uTime*.1));
      float band=exp(-pow((el-ce)/w,2.))*(.4+.6*smoothstep(ce,ce+w*2.5,el+w));
      float cur=.25+.75*pow(vnoise(ring*19.+vec2(fi*9.,uTime*.25)),1.5);
      nightC+=bright(hue(.35+fi*.22+sin(ax*2.)*.12+(el-ce)*1.5+uTime*.02+V*.25),.9)*band*cur*(.55-.13*fi)*u_auroraStrength*1.6;
    }
  }
  nightC+=stars(d,.01+.08*u_starAmount)*smoothstep(.5,.95,1.-day)*mix(vec3(1.),film(el*30.+sin(ax)*7.),.5)*1.2;
  vec3 c=mix(nightC,dayC,day);
  c=mix(c,duskC,dusk*.62);

  // ---- sun: pearl disc, corona, 22 degree halo. drawn before the clouds so they pass in front
  float ang=angTo(d,s), up=smoothstep(-.12,.04,s.y)*u_sunOn, R=u_sunSize;
  float lit=max(day,dusk*.8)*u_sunOn;
  c+=film(ang*4.-.2)*exp(-pow((ang-.38)/.028,2.))*.45*u_halo*lit;
  c+=film(ang/R*.5+.1)*exp(-pow((ang-R*1.8)/(R*1.1),2.))*.35*u_corona*lit;
  c+=vec3(1.,.96,.94)*exp(-ang/R*.7)*.3*up;
  vec3 pearlC=mix(vec3(1.,.99,.97),film(ang*14.+flow*2.),.2);
  c=mix(c,pearlC,(1.-smoothstep(R-PX,R+PX,ang))*up);
  // rainbow opposite the sun
  float ar=angTo(d,-s), rx=(ar-.72)/.045;
  c+=spectrum(clamp(rx*.5+.5,0.,1.))*exp(-rx*rx*1.5)*.36*u_rainbowStrength*u_rainbowOn*day*smoothstep(0.,.06,d.y)*(oil?.6:1.);
  // pearl moon with a film halo
  float ma=angTo(d,-s), mup=smoothstep(-.12,.04,-s.y);
  c=mix(c,mix(vec3(.92,.9,1.),film(ma*12.+flow),.3),(1.-smoothstep(.034-PX,.034+PX,ma))*mup);
  c+=film(ma*5.)*exp(-pow((ma-.09)/.012,2.))*.25*mup+vec3(.7,.65,1.)*exp(-ma*10.)*.15*mup;

  // ---- iridescent clouds: soft bodies, rainbow on the thin edges
  if(u_cloudsOn>.5){
    vec2 cp=d.xz/(d.y+.12)*.33+vec2(flow*.6,0.);
    float cn=fbm(cp*1.3);
    float th=.86-u_cloudCover*.42;
    float hz=smoothstep(.03,.2,d.y);
    float cm=smoothstep(th,th+.07,cn)*hz;
    float rim=smoothstep(th-.02,th+.015,cn)*(1.-smoothstep(th+.015,th+.11,cn));
    vec3 cf=film(cn*6.+V*1.4+ang*2.5);
    vec3 cc=u_cloudTint*mix(vec3(1.),cf,pearl?.15:.25)*mix(vec3(.3,.26,.48),vec3(1.),max(day,.12));
    if(oil) cc=mix(vec3(.05,.05,.09),cf*.5,.35)+.05*day;
    cc=mix(cc,mix(vec3(.6,.45,.62),vec3(1.,.72,.62),pow(sunSide(d),2.)),dusk*.45);
    c=mix(c,cc,cm*.9);
    c+=cf*rim*u_cloudEdge*(oil?1.1:.7)*mix(.3,1.,max(day,dusk))*hz;
    // sun still glows through thin cloud
    c+=vec3(1.,.97,.95)*(exp(-ang*30.)*.25+exp(-ang*4.)*.35)*up*cm;
  }

  // ---- soap bubbles drifting across the sky
  if(u_bubblesOn>.5){
    for(int i=0;i<7;i++){
      float fi=float(i);
      if(fi>=u_bubbleCount) break;
      float baz=h11(fi*3.1)*TAU+uTime*.01*(.5+h11(fi+7.));
      float bel=.1+.55*h11(fi*5.3)+.025*sin(uTime*.25+fi*2.);
      vec3 bc=vec3(cos(bel)*cos(baz),sin(bel),cos(bel)*sin(baz));
      float r=(.02+.05*u_bubbleSize)*(.6+.8*h11(fi*9.7)), a=angTo(d0,bc), q=a/r;
      if(q<1.08){
        float px=PX/r;
        float inside=1.-smoothstep(1.-px,1.,q);
        // round the rim in a frame fixed to the bubble, not the camera, so the rim doesn't turn with your head
        vec3 bx=normalize(cross(bc,vec3(0.,1.,0.))), by=cross(bx,bc);
        float wob=vnoise(vec2(atan(dot(d0,by),dot(d0,bx))*3.+fi,uTime*.3));
        vec3 bf=film(q*2.2+fi*.7+uTime*.12+wob*.8+V);
        float edge=smoothstep(.62,.97,q)*(1.-smoothstep(.97,1.+px*1.5,q));
        c=mix(c,c*.9+bf*.22,inside*.4);
        c+=bf*edge*.8;
        vec3 e1=normalize(d0-bc*dot(d0,bc)), e2=normalize(s-bc*dot(s,bc)+1e-4);
        float spec=pow(max(dot(e1,e2),0.),24.)*smoothstep(.45,.62,q)*(1.-smoothstep(.62,.8,q));
        c+=vec3(1.)*spec*mix(.25,1.,max(day,dusk))*inside;
      }
    }
  }

  // ---- facet edges catch the light
  c=mix(c,mix(vec3(1.),film(ph*2.+fid*3.),.6)*mix(.5,1.15,day),facet*.65*smoothstep(-.05,.1,d0.y));
  // ---- glitter
  c+=glint(d0)*u_glitterOn*mix(vec3(1.),film(h21(floor(d0.xz*40.))*3.),.4)*mix(1.3,.75,day);

  return c;
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
