#version 150

// Terminal sky. Generated by tools/skylab/port.js from tools/skylab/styles/terminal.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    vec4 c_phosphor;
    vec4 c_background;
    vec4 c_accent;
    float u_fullColour;
    float u_charset;
    float u_cellSize;
    float u_brightness;
    float u_skyFill;
    float u_crtOn;
    float u_glow;
    float u_scanlines;
    float u_flicker;
    float u_vignette;
    float u_sunOn;
    float u_sunSize;
    float u_sunRays;
    float u_moonPhase;
    float u_cloudOn;
    float u_cover;
    float u_cloudScale;
    float u_wind;
    float u_starsOn;
    float u_starDensity;
    float u_twinkle;
    float u_meteors;
    float u_rainOn;
    float u_rainAmount;
    float u_rainSpeed;
    vec4 c_rainColor;
};
#define u_phosphor c_phosphor.rgb
#define u_background c_background.rgb
#define u_accent c_accent.rgb
#define u_rainColor c_rainColor.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

float gcode(float k){if(k<0.5) return 6929814.;if(k<1.5) return 4998222.;if(k<2.5) return 6890639.;if(k<3.5) return 14770462.;if(k<4.5) return 10088721.;if(k<5.5) return 16310558.;if(k<6.5) return 6875542.;if(k<7.5) return 15803460.;if(k<8.5) return 6908310.;if(k<9.5) return 6919958.;if(k<10.5) return 0.;if(k<11.5) return 4.;if(k<12.5) return 262208.;if(k<13.5) return 3840.;if(k<14.5) return 61680.;if(k<15.5) return 20032.;if(k<16.5) return 675402.;if(k<17.5) return 719610.;if(k<18.5) return 13444275.;if(k<19.5) return 6929287.;if(k<20.5) return 8553090.;if(k<21.5) return 10855845.;if(k<22.5) return 12574655.;if(k<23.5) return 16777215.;if(k<24.5) return 1123464.;if(k<25.5) return 8929809.;if(k<26.5) return 4473924.;if(k<27.5) return 15.;if(k<28.5) return 8660096.;if(k<29.5) return 27030.;if(k<30.5) return 6922137.;if(k<31.5) return 15803535.;if(k<32.5) return 8020962.;return 0.;}
float rampA(float k){if(k<0.5) return 10.;if(k<1.5) return 11.;if(k<2.5) return 12.;if(k<3.5) return 13.;if(k<4.5) return 14.;if(k<5.5) return 15.;if(k<6.5) return 16.;if(k<7.5) return 17.;if(k<8.5) return 18.;return 19.;}
float rampB(float k){if(k<0.5) return 10.;if(k<1.5) return 11.;if(k<2.5) return 20.;if(k<3.5) return 21.;if(k<4.5) return 22.;return 23.;}
float rampC(float k){if(k<0.5) return 10.;if(k<1.5) return 11.;if(k<2.5) return 12.;if(k<3.5) return 0.;return 1.;}
float rainG(float k){if(k<0.5) return 0.;if(k<1.5) return 1.;if(k<2.5) return 2.;if(k<3.5) return 3.;if(k<4.5) return 4.;if(k<5.5) return 5.;if(k<6.5) return 6.;if(k<7.5) return 7.;if(k<8.5) return 8.;if(k<9.5) return 9.;if(k<10.5) return 30.;if(k<11.5) return 31.;if(k<12.5) return 32.;if(k<13.5) return 15.;if(k<14.5) return 16.;if(k<15.5) return 24.;return 26.;}

float ramp(float set, float b){
  b=clamp(b,0.,.999);
  if(set<.5) return rampA(floor(b*10.));
  if(set<1.5) return rampB(floor(b*6.));
  return rampC(floor(b*5.));
}
float gbit(float c, float x, float y){
  if(x<0.||x>3.||y<0.||y>5.) return 0.;
  return mod(floor(c/exp2((5.-y)*4.+(3.-x))),2.);
}
// screen positions and view rays both go through the engine's camRay and camScreen, so the cells line up with the world.
// the grid is laid on sheet(), which scrolls as you look round, so the characters ride with the sky: on a grid
// fixed to the screen the sky slid under the cells and every character shimmered as you turned
vec3 sky(vec3 dIn){
  float cw=u_cellSize*SC, ch=cw*1.4, pw=cw/5.;
  vec2 G=sheet(), off=G-FC;
  float cx=floor(G.x/cw), cyT=floor(-G.y/ch);
  vec2 org=vec2(cx*cw, -(cyT+1.)*ch)-off;
  vec2 cc=org+vec2(cw,ch)*.5;
  vec3 dc=camRay(cc);
  vec2 gp=(FC-org)/pw;
  float gx=floor(gp.x), gy=6.-floor(gp.y);
  vec2 sp=fract(gp)-.5;
  vec3 s=sunDir(); float day=dayF(), dusk=duskF(), y=max(dc.y,0.);

  // sky haze: what the empty cells fade from
  vec3 col=mix(mix(vec3(.1,.12,.3),vec3(.55,.8,1.),day), mix(vec3(.05,.07,.2),vec3(.15,.4,.95),day), pow(y,.5));
  col=mix(col,vec3(1.,.45,.2),dusk*pow(sunSide(dc),3.)*pow(1.-y,4.));
  float fill=u_skyFill*.01;
  float b=fill*(mix(.04,.25,day)*pow(1.-y,3.)+.65*dusk*pow(sunSide(dc),3.)*pow(1.-y,6.)+.17*day);
  b+=(h21(vec2(cx,cyT))-.5)*.12*fill*step(.02,b);
  float gid=-1., hl=0., body=0.;

  // stars, fixed to the sky; only the cell nearest each star draws it
  if(u_starsOn>.5){
    float el=elev(dc), gs=ch/uRes.y*2.5;
    vec2 sc=vec2(atan(dc.z,dc.x)*cos(el), el);
    vec2 q=floor(sc/gs), st=(q+.2+.6*h22(q+1.))*gs;
    float sa=st.x/max(cos(st.y),.05), sf;
    vec2 ssp=camScreen(vec3(cos(st.y)*cos(sa), sin(st.y), cos(st.y)*sin(sa)), sf);
    float vis=smoothstep(.5,.95,1.-day)*smoothstep(.03,.12,dc.y);
    if(vis>.01 && h21(q+11.)<u_starDensity*.006 && sf>0. && floor((ssp.x+off.x)/cw)==cx && floor(-(ssp.y+off.y)/ch)==cyT){
      float hs=h21(q+3.), tw=sin(uTime*(1.5+3.*h21(q+5.))+hs*40.);
      gid=hs>.7?16.:(hs>.35?15.:11.);
      if(tw>1.-u_twinkle*.012) gid=15.;
      if(tw<-1.+u_twinkle*.01) gid=11.;
      b=vis*(.7+.3*h21(q+9.)); col=vec3(1.);
    }
  }

  // sun disc in the sky, rays in screen space so they line up with the character grid
  if(u_sunOn>.5){
    // at least a few characters across, or a small sun is just one @
    float R=max(radians(u_sunSize)*.5, ch/uRes.y*1.6);
    float a=angTo(dc,s), up=smoothstep(-.12,.02,s.y);
    if(a<R && up>0.){ float k=a/R; b=up*(1.-.6*k*k); gid=-1.; col=mix(vec3(1.,1.,.8),vec3(1.,.55,.15),dusk); body=1.; }
    float front; vec2 ss=camScreen(s,front);
    if(u_sunRays>.5 && front>0. && a>=R && up>0.){
      vec2 off=cc-ss; float r=length(off), rr=R*uRes.y;
      float an=atan(off.y,off.x), k=floor(an/(PI*.25)+.5), da=an-k*PI*.25;
      if(abs(sin(da))*r<cw*.55 && r>rr+ch*.6 && r<rr+ch*(2.4+.8*sin(uTime*1.3+k))){
        float m=mod(k+8.,4.);
        gid=m<.5?13.:(m<1.5?24.:(m<2.5?26.:25.));
        body=1.; b=.85*up; col=mix(vec3(1.,1.,.7),vec3(1.,.55,.15),dusk);
      }
    }
    // moon: a disc with a shadow disc slid across it for the phase, craters as o
    vec3 m=-s; float ma=angTo(dc,m), mr=max(R*.9, ch/uRes.y*2.4), mup=smoothstep(-.12,.02,m.y);
    if(ma<mr && mup>0.){
      vec3 e1=normalize(cross(m,vec3(0.,1.,0.))), e2=cross(e1,m);
      vec3 mo=normalize(m+e1*mr*2.2*u_moonPhase*.01);
      float lit=step(mr,angTo(dc,mo))+step(99.5,u_moonPhase);
      vec2 lc=vec2(dot(dc,e1),dot(dc,e2))/mr;
      if(lit>.5){ body=1.; b=.75*mup; gid=vnoise(lc*2.6+3.)>.66?29.:-1.; col=vec3(.85,.9,1.); }
      else { body=1.; b=.22*mup; gid=-1.; col=vec3(.5,.55,.7); }
    }
  }

  // clouds: brightness picks the character, so edges thin out to dots
  if(u_cloudOn>.5 && dc.y>0.){
    vec2 p=dc.xz/(dc.y+.12)*mix(1.1,.3,u_cloudScale*.01)+vec2(uTime*u_wind*.004,uTime*u_wind*.001);
    float n=fbm(p), th=mix(.72,.3,u_cover*.01);
    float cd=smoothstep(th,th+.22,n)*smoothstep(0.,.08,dc.y);
    if(cd>.02){
      float nt=fbm(p+normalize(s.xz+1e-5)*.12);
      float lit=clamp(.55+(n-nt)*5.,.15,1.);
      float bc=(.3+.7*smoothstep(0.,.7,cd))*mix(.5,1.,lit)*mix(.25,1.,day)+dusk*.15*cd;
      vec3 cc2=mix(vec3(.45,.5,.7),vec3(1.),day); cc2=mix(cc2,vec3(1.,.6,.6),dusk*.7);
      if(cd>.35){ b=bc; gid=-1.; col=cc2; }
      // cloud always covers the sun and moon, even where it thins out
      else if(bc>b || body>.5){ b=bc; gid=-1.; col=cc2; }
    }
  }

  // shooting stars: a slash run down-left across the character grid
  if(u_starsOn>.5 && u_meteors>.5){
    float P=60./u_meteors, k=floor(uTime/P), f=uTime-k*P;
    // somewhere round the sky, in the upper rows when looking level, on the same scrolled grid as everything else
    float turnCols=floor(TAU/PX/cw), rows=uRes.y/ch;
    float x0=floor(h11(k)*turnCols), y0=floor(h11(k+3.)*rows*.3)+1.-rows;
    float hp=f*(16.+12.*h11(k+5.)), i=mod(x0-cx,turnCols);
    if(f<1.8 && i>=0. && cyT-y0==i && i<=hp && i>hp-7. && dc.y>.03){
      b=(1.-(hp-i)/7.)*(1.-.75*day); gid=i>hp-1.?16.:24.; hl=1.; col=vec3(1.);
    }
  }

  // data rain: columns of changing characters falling down the screen
  if(u_rainOn>.5 && h11(cx*1.37+.5)<u_rainAmount*.01){
    float spd=(3.+9.*h11(cx+2.))*mix(.2,2.,u_rainSpeed*.01), trail=6.+10.*h11(cx+4.);
    float hp=mod(uTime*spd+h11(cx+6.)*50., uRes.y/ch+trail), dist=mod(hp-cyT, uRes.y/ch+trail);
    if(dist>=0. && dist<trail){
      float fr=1.-dist/trail, rb=fr*fr*.9+.1;
      if(rb>b){
        b=rb; col=u_rainColor; hl=dist<1.?1.:0.;
        gid=rainG(floor(h21(vec2(cx,cyT+floor(uTime*(2.+4.*h11(cx+9.)))))*17.));
      }
    }
  }

  if(gid<0.) gid=ramp(u_charset,b);
  float c=gcode(gid);
  float I=gbit(c,gx,gy)*(1.-smoothstep(.36,.5,max(abs(sp.x),abs(sp.y))));
  float crt=u_crtOn;
  if(crt>.5 && u_glow>0.){
    float g=0.;
    for(int j=-1;j<=1;j++) for(int i=-1;i<=1;i++){
      vec2 o=sp-vec2(float(i),-float(j));
      g+=gbit(c,gx+float(i),gy+float(j))*exp(-dot(o,o)*1.8);
    }
    I=max(I,min(g,1.4)*u_glow*.0065);
  }

  vec3 ink=u_phosphor;
  // 16-colour look: push saturation, then snap each channel to off, half or full
  if(u_fullColour>.5){ vec3 q=col-.7*min(col.r,min(col.g,col.b)); q/=max(max(q.r,max(q.g,q.b)),1e-3); ink=floor(q*2.+.5)/2.; }
  if(hl>.5) ink=u_accent;
  ink*=u_brightness*.01;
  vec3 o=mix(u_background,ink,clamp(I*(.45+.55*clamp(b,0.,1.)),0.,1.));
  if(crt>.5){
    o=mix(o,ink,clamp(b,0.,1.)*u_glow*.0012);
    o*=1.-u_scanlines*.005*smoothstep(.2,.5,abs(sp.y));
    float roll=exp(-pow((FC.y/uRes.y-fract(-uTime*.11))*14.,2.));
    o*=1.-u_flicker*.0009*vnoise(vec2(uTime*30.,0.))+u_flicker*.0012*roll;
    o*=1.-u_vignette*.006*pow(length(FC/uRes-.5)*1.4,2.);
  }
  return o;
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
