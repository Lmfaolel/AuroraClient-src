#version 150

// Sketch sky. Generated by tools/skylab/port.js from tools/skylab/styles/sketch.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    float u_mode;
    vec4 c_ink;
    vec4 c_paper;
    float u_grain;
    float u_ruled;
    float u_grid;
    float u_lineWidth;
    float u_wobble;
    float u_boil;
    float u_shading;
    float u_spacing;
    float u_strokeLen;
    float u_smudge;
    float u_washOn;
    float u_washAmt;
    vec4 c_washDay;
    vec4 c_washSunset;
    vec4 c_washNight;
    float u_cloudsOn;
    float u_coverage;
    float u_cloudSize;
    float u_cloudSpeed;
    float u_highClouds;
    float u_puffLines;
    float u_sunSize;
    float u_sunRays;
    float u_moonPhase;
    float u_craters;
    float u_starsOn;
    float u_starAmt;
    float u_constellations;
    float u_shooting;
    float u_birdsOn;
    float u_birdAmt;
};
#define u_ink c_ink.rgb
#define u_paper c_paper.rgb
#define u_washDay c_washDay.rgb
#define u_washSunset c_washSunset.rgb
#define u_washNight c_washNight.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

// PP is where on the paper this pixel is, in pixels. the paper stays still in front of you like a page (grain,
// ruled lines, grid), and everything drawn on it (clouds, hatching, the wash) is pinned to the sky, see hatch()
vec2 PP;
float isL(float k){ return 1.-step(.5,abs(u_mode-k)); }
// redrawing the lines a few times a second made the whole page crawl, so it is a switch and off by default
float boilK(){ return u_boil*floor(uTime*(1.+5.*u_wobble)); }
vec2 boilOff(){ return (h22(vec2(boilK(),1.))-.5)*(1.+6.*u_wobble)*SC; }
float gapAmt(){ return .3*isL(0.)+.08*isL(1.)+.45*isL(2.); }
// an ink line of weight w, dist in radians
float stroke(float dist, float w){
  w*=u_lineWidth;
  return 1.-smoothstep(w*.45*PX*SC,w*1.3*PX*SC,dist);
}
// a pixel at 1080p and a 70 degree fov, so stroke spacing and wobble are angles on the sky and turning moves nothing
const float PXR=.0013;
float hq(vec2 p){ vec3 p3=fract(vec3(p.xyx)*.1031); p3+=dot(p3,p3.yzx+33.33); return fract((p3.x+p3.y)*p3.z); }
float qnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(hq(i),hq(i+vec2(1.,0.)),f.x), mix(hq(i+vec2(0.,1.)),hq(i+vec2(1.,1.)),f.x), f.y); }
// one family of strokes. u runs across them and v along them, both radians on the sky. widths are screen pixels
float hline(float u, float v, float sp, float seed, float wt){
  float vp=v/PXR;
  u+=(qnoise(vec2(vp*.012/SC,seed))-.5)*(1.+4.*u_wobble)*SC*PXR;
  float k=floor(u/sp);
  float dist=abs(fract(u/sp)-.5)*sp/PX;
  float g=gapAmt();
  float gap=g>0.?step(g,qnoise(vec2(vp*.018/SC+k*7.3,k*1.7+seed))):1.;
  float press=g>.01?.5+.5*qnoise(vec2(vp*.01/SC,k+seed*3.)):1.;
  // light shading draws thin faint lines, not the same line greyed out
  float w=u_lineWidth*SC*(.35+.65*wt);
  return (1.-smoothstep(.3*w,1.05*w,dist))*gap*press*min(1.,wt*1.6);
}
// the hatching is short strokes in patches pinned to the sky. patches are cells on the sky seen from straight below
// (stereographic from the nadir, so the one seam is under the ground) and blend into their neighbours at the edges.
// each stroke is a great circle, so it is straight on screen and exactly fixed to the sky: a patch's strokes all turn
// about the axis u lying along them, angled off the horizon at the patch. lines ruled on a cube round you fanned out to
// vanishing points and went to moire where the faces met, strokes spaced in screen pixels stretched as you turned
vec3 SD;
vec3 dirOf(vec2 p){ float q=dot(p,p); return vec3(2.*p.x,1.-q,2.*p.y)/(1.+q); }
float fam(vec3 dc, vec3 th, vec3 tv, float a, float sp, float seed, float wt){
  vec3 u=cos(a)*th+sin(a)*tv, w=cross(dc,u);
  float z=dot(SD,dc);
  return hline(atan(dot(SD,w),z)+boilOff().x*PXR,atan(dot(SD,u),z),sp,seed,wt);
}
float patchH(vec2 c, float cs, float tone, float ang){
  vec3 dc=dirOf((c+.5)*cs);
  // the horizon's direction at the patch, pointing screen right in the lab and in game (the lab's camera is mirrored)
  float flip=-dot(cross(camRight(),camUp()),FWD);
  vec3 th=normalize(vec3(-dc.z,0.,dc.x))*flip, tv=cross(th,dc)*flip;
  float a=ang+(h21(c)-.5)*.3, s=h21(c+5.)*40., sp=u_spacing*.0021, h=0., w;
  w=smoothstep(.08,.3,tone); if(w>0.) h=fam(dc,th,tv,a,sp,1.+s,w);
  w=smoothstep(.34,.55,tone); if(w>0.) h=max(h,fam(dc,th,tv,a-1.7,sp*1.05,2.+s,w));
  w=smoothstep(.56,.76,tone); if(w>0.) h=max(h,fam(dc,th,tv,a-.84,sp*.95,3.+s,w));
  w=smoothstep(.78,.94,tone); if(w>0.) h=max(h,fam(dc,th,tv,a+.04,sp,4.+s,w));
  return h;
}
float hatch(float tone, float ang){
  if(tone<.08) return 0.;
  float cs=.11*u_strokeLen;
  vec2 q=SD.xz/(1.+max(SD.y,-.9))/cs-.5, i=floor(q), s=smoothstep(.38,.62,fract(q));
  float h=0.;
  for(int k=0;k<4;k++){
    vec2 o=vec2(float(k-k/2*2),float(k/2));
    float w=mix(1.-s.x,s.x,o.x)*mix(1.-s.y,s.y,o.y);
    if(w>.002) h+=w*patchH(i+o,cs,tone,ang);
  }
  return h;
}
vec2 seg(vec2 p, vec2 a, vec2 b){ vec2 pa=p-a, ba=b-a; float t=clamp(dot(pa,ba)/dot(ba,ba),0.,1.); return vec2(length(pa-ba*t),t); }

// the sheet the sky is drawn on. sky() sets PP, see the top
vec3 paper(float night){
  float g=vnoise(PP*.9)*.5+vnoise(PP*.23)*.3+vnoise(PP*vec2(.015,.35))*.2;
  vec3 c=u_paper*(1.-u_grain*.12+u_grain*.12*g);
  float rs=26.*SC, rf=fract(PP.y/rs);
  float rule=1.-smoothstep(.35*SC,1.1*SC,min(rf,1.-rf)*rs);
  c=mix(c,vec3(.55,.72,.92),rule*.55*u_ruled);
  float margin=1.-smoothstep(.5*SC,1.4*SC,abs(PP.x-70.*SC));
  c=mix(c,vec3(.88,.36,.4),margin*.6*u_ruled);
  float gs=24.*SC; vec2 gf=abs(fract(PP/gs+.5)-.5)*gs;
  float gl=1.-smoothstep(.3*SC,1.*SC,min(gf.x,gf.y));
  c=mix(c,u_ink,gl*.16*u_grid);
  // blueprint paper goes navy at night, pencil paper only greys a touch
  return c*mix(1.,.5,night*isL(3.));
}

// one cloud deck. x: cover, y: outline ink, z: tone
vec3 deck(vec3 d, float h, float sc, float spd, float off, float th, vec3 s, float day){
  float dh=d.y+h, k=sc/u_cloudSize;
  vec2 p=d.xz/dh*k+vec2(uTime*spd*(.02+.3*u_cloudSpeed),off);
  float n=fbm(p);
  // the slope on screen: the deck stretches by k/dh across and k(1+h y)/dh^2 toward the horizon
  float Jt=k/dh, Jr=k*(1.+h*d.y)/(dh*dh);
  // clear sky further from an edge than the outline can reach (fbm's slope stays under 6) needs no slope
  if(n<th-6.*max(Jt,Jr)*2.*u_lineWidth*PX*SC) return vec3(0.);
  vec2 gr=vec2(fbm(p+vec2(.03,0.))-n,fbm(p+vec2(0.,.03))-n)/.03;
  vec2 rh=normalize(d.xz+1e-5), th2=vec2(-rh.y,rh.x);
  float G=max(length(vec2(dot(gr,th2)*Jt,dot(gr,rh)*Jr)),1e-3);
  float fade=smoothstep(.02,.14,d.y);
  float m=smoothstep(th-.004,th+.004,n)*fade;
  // denser toward the sun means this side sits in its own shadow
  float sh=clamp(dot(gr,normalize(s.xz+1e-5))*.4+.12,0.,.72)+clamp(-dot(gr,rh)*.25,0.,.2);
  float tone=mix(.5,sh,day);
  // far away the deck is a smear of tiny shapes, an artist leaves those as tone
  float lod=1.-smoothstep(9.,22.,Jr);
  float brk=mix(1.,step(.2,vnoise(p*14.+boilK()*.37)),gapAmt()*1.5);
  float ol=stroke(abs(n-th)/G,1.5)*fade*brk*lod;
  ol=max(ol,stroke(abs(n-th-.07)/G,1.)*step(1.-u_puffLines,vnoise(p*4.+boilK()*.37))*m*.85*lod);
  return vec3(m,ol,tone);
}

float birds(float az, float el, float day){
  vec2 q=vec2(az*cos(el)*10.+uTime*.06,el*10.);
  vec2 c=floor(q);
  float h=h21(c+11.);
  vec2 f=fract(q)-.5-(h22(c+4.)-.5)*.4;
  float s=.09+.05*h21(c+2.);
  vec2 b=f/s;
  float flap=sin(uTime*(5.+3.*h)+h*30.)*.35;
  float yw=(abs(b.x)-.45*b.x*b.x)*(.55+flap);
  float on=step(1.-.12*u_birdAmt,h)*step(.4,vnoise(c*.35+7.))*step(abs(b.x),1.)*smoothstep(.06,.14,el)*step(el,.55);
  return on*stroke(abs(b.y-yw)*s/10.,1.1)*day*u_birdsOn;
}

const float SN=22.;
vec2 sPos(vec2 c){ return c+.5+(h22(c)-.5)*.6; }
float sHas(vec2 c){ return step(1.-.2*u_starAmt,h21(c)); }

vec3 sky(vec3 d){
  vec3 s=sunDir(); float day=dayF(), dusk=duskF(), night=1.-day, y=max(d.y,0.);
  float el=elev(d), az=atan(d.z,d.x), bk=boilK();
  SD=d; PP=FC;
  float tone=mix(.78-.1*exp(-y*6.),.03+.2*pow(y,1.3),smoothstep(.15,.85,day));
  tone+=dusk*.1*(1.-sunSide(d))*smoothstep(.1,.5,y);
  float ink=0.;

  // stars and constellations
  float nf=smoothstep(.5,.85,night)*smoothstep(.03,.14,d.y)*u_starsOn;
  if(nf>.01){
    vec2 q=vec2(az*cos(el),el)*SN, ci=floor(q);
    float sInk=0., hole=0.;
    for(int j=-1;j<=1;j++) for(int i=-1;i<=1;i++){
      vec2 c=ci+vec2(float(i),float(j));
      float has=sHas(c);
      if(has<.5) continue;
      vec2 f=(q-sPos(c))/SN;
      // a cleared spot of paper with a little four point sparkle in it
      float big=h21(c+1.), rad=length(f), arm=(.005+.008*big)*(1.-.45*isL(2.));
      hole=max(hole,has*(1.-smoothstep(arm+.003,arm+.006,rad)));
      float spark=abs(f.x)*abs(f.y)/(arm*arm)*60.;
      sInk=max(sInk,has*(1.-smoothstep(.5,1.5,spark))*(1.-smoothstep(arm*.8,arm,rad)));
      for(int k=0;k<2;k++){
        vec2 o=k==0?vec2(1.,0.):vec2(0.,1.);
        if(u_constellations*sHas(c+o)*step(.55,h21(c+o*7.+vec2(3.,5.)))>.5 && vnoise(c*.2+3.)>.52){
          vec2 a=sPos(c), b=sPos(c+o);
          vec2 r=seg(q,a,b);
          float L=length(b-a), tq=r.y*L;
          sInk=max(sInk,stroke(r.x/SN,.8)*step(.5,fract(tq*4.))*step(.3,min(tq,L-tq))*.85);
        }
      }
    }
    tone*=1.-hole*nf;
    ink=max(ink,sInk*nf);
  }

  // shooting star, every few seconds at night
  if(u_shooting*nf>.01){
    float per=4.5, k=floor(uTime/per), t=fract(uTime/per)*per;
    // anywhere round the sky: placed where you looked, a shooting star in flight turned with you
    float a0=h11(k+1.3)*TAU;
    float ad=mod(az-a0+PI,TAU)-PI;
    vec2 p=vec2(ad*cos(el),el);
    vec2 st=vec2((h11(k+2.1)-.5)*.3,.45+.25*h11(k+3.7));
    vec2 dir=normalize(vec2(h11(k+4.9)>.5?1.:-1.,-.55-.3*h11(k+5.3)));
    float pr=min(t,1.)*.5;
    vec2 head=st+dir*pr, tail=st+dir*max(pr-.22,0.);
    vec2 r=seg(p,tail,head);
    float on=step(.35,h11(k+.7))*(1.-smoothstep(1.,1.3,t))*nf;
    float dash=mix(step(.4,fract(r.y*7.-t*3.)),1.,r.y);
    ink=max(ink,on*max(stroke(r.x,1.)*dash,stroke(length(p-head),2.2)));
  }

  // sun: two wobbly loops, paper inside, pencil rays around
  float ang=angTo(d,s);
  vec3 e1=normalize(cross(s,vec3(0.,1.,0.))), e2=cross(e1,s);
  float a2=atan(dot(d,e2),dot(d,e1));
  float R=.07*u_sunSize;
  float r1=R+(vnoise(vec2(a2*1.6+bk*1.7,3.))-.5)*.012*u_sunSize;
  float r2=R+.005+(vnoise(vec2(a2*2.1+bk*1.3,9.))-.5)*.014*u_sunSize;
  float up=smoothstep(-.12,.0,s.y);
  tone=mix(tone,0.,up*(1.-smoothstep(r1-.004,r1+.004,ang)));
  ink=max(ink,stroke(abs(ang-r1),1.7)*up);
  ink=max(ink,stroke(abs(ang-r2),1.1)*step(.35,vnoise(vec2(a2*2.5,bk)))*up);
  float rk=floor(a2/TAU*16.+.5), ra=rk/16.*TAU;
  float da=mod(a2-ra+PI,TAU)-PI;
  float rlen=R+.018+(.015+.03*h11(rk+bk)+.02*mod(rk,2.))*u_sunSize;
  ink=max(ink,stroke(abs(da)*ang,1.3)*step(R+.016,ang)*step(ang,rlen)*day*u_sunRays*up);

  // moon: lit part paper, the rest hatched, a few crater scribbles
  vec3 m=-s; float ma=angTo(d,m);
  vec3 f1=normalize(cross(m,vec3(0.,1.,0.))), f2=cross(f1,m);
  float b=atan(dot(d,f2),dot(d,f1));
  float mr=.06+(vnoise(vec2(b*1.5+bk,5.))-.5)*.007;
  float mup=smoothstep(-.12,.0,m.y);
  vec3 mo=normalize(m+f1*mix(-.12,.12,u_moonPhase));
  float inM=1.-smoothstep(mr-.002,mr+.002,ma);
  float dark=1.-step(mr,angTo(d,mo));
  // moonlight thins the hatching around it
  tone-=.35*exp(-ma*4.)*mup*night;
  tone=mix(tone,mix(0.,.68,dark),inM*mup);
  ink=max(ink,stroke(abs(ma-mr),1.6)*mup);
  ink=max(ink,stroke(abs(angTo(d,mo)-mr),1.)*inM*mup);
  vec2 ml=vec2(dot(d,f1),dot(d,f2));
  float cr=stroke(abs(length(ml-vec2(-.018,.02))-.011),.8);
  cr=max(cr,stroke(abs(length(ml-vec2(.012,-.022))-.008),.8));
  cr=max(cr,stroke(abs(length(ml-vec2(.022,.012))-.006),.7));
  ink=max(ink,cr*inM*(1.-dark)*mup*u_craters);

  // wash, before the clouds so they can lighten it
  vec3 wash=mix(u_washNight,u_washDay*mix(1.,.82,y),day);
  wash=mix(wash,u_washSunset,dusk*pow(sunSide(d),2.)*.9);
  wash=mix(wash,mix(u_washNight,vec3(1.),.35),dusk*pow(1.-sunSide(d),2.)*.5);
  wash=mix(wash,vec3(1.,.93,.6),exp(-ang*10.)*up*.8);
  float cm=0.;

  // clouds: the high deck, then birds, then the low deck, each covering what is behind it
  float th=.63-u_coverage*.22;
  if(u_cloudsOn>.5){
    if(u_highClouds>.5){
      vec3 c=deck(d,.32,.24,.15,0.,th+.05,s,day);
      tone=mix(tone,c.z,c.x); ink=max(ink*(1.-c.x),c.y); cm=max(cm,c.x);
    }
  }
  ink=max(ink,birds(az,el,day));
  if(u_cloudsOn>.5){
    vec3 c=deck(d,.07,.42,.3,9.3,th,s,day);
    tone=mix(tone,c.z,c.x); ink=max(ink*(1.-c.x),c.y); cm=max(cm,c.x);
  }
  wash=mix(wash,mix(vec3(1.),u_washSunset,dusk*.6),cm*.7);

  float t2=tone*u_shading*(1.-.5*isL(3.));
  // charcoal keeps light areas as smudge and only strokes the darks
  float a=hatch(t2-.25*isL(2.),mix(.9,.3,cm))*.82;
  float tooth=vnoise(PP*.8)*.6+vnoise(PP*.27)*.4;
  a=max(a,smoothstep(.12-.12*isL(2.),1.-.3*isL(2.),t2)*(.35+.65*tooth)*u_smudge);
  a=max(a,ink);
  vec3 pc=paper(night);
  float bleed=.6+.4*vnoise(SD.xz*3.+vec2(SD.y*2.,3.));
  pc*=mix(vec3(1.),wash,u_washAmt*u_washOn*.75*bleed);
  return mix(pc,u_ink,a*.92);
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
