#version 150

// Comic sky. Generated by tools/skylab/port.js from tools/skylab/styles/comic.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    vec4 c_ink;
    vec4 c_paper;
    float u_lineWidth;
    float u_dotSize;
    float u_halftone;
    float u_misprint;
    float u_mono;
    vec4 c_dayTop;
    vec4 c_dayHorizon;
    vec4 c_sunsetTop;
    vec4 c_sunsetHorizon;
    vec4 c_nightTop;
    vec4 c_nightHorizon;
    float u_sunOn;
    float u_sunSize;
    float u_rays;
    vec4 c_sunColor;
    vec4 c_moonColor;
    float u_cloudOn;
    float u_cloudAmount;
    float u_cloudSize;
    float u_wind;
    vec4 c_cloudColor;
    vec4 c_cloudShade;
    float u_starsOn;
    float u_starDensity;
    vec4 c_starColor;
};
#define u_ink c_ink.rgb
#define u_paper c_paper.rgb
#define u_dayTop c_dayTop.rgb
#define u_dayHorizon c_dayHorizon.rgb
#define u_sunsetTop c_sunsetTop.rgb
#define u_sunsetHorizon c_sunsetHorizon.rgb
#define u_nightTop c_nightTop.rgb
#define u_nightHorizon c_nightHorizon.rgb
#define u_sunColor c_sunColor.rgb
#define u_moonColor c_moonColor.rgb
#define u_cloudColor c_cloudColor.rgb
#define u_cloudShade c_cloudShade.rgb
#define u_starColor c_starColor.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

float wrapA(float a){ return mod(a+PI,TAU)-PI; }
vec2 frame(vec3 d, vec3 s){ vec3 e1=normalize(cross(s,vec3(0.,1.,0.))), e2=cross(e1,s); return vec2(dot(d,e1),dot(d,e2)); }
// ink line of the outline width, d is a signed distance in radians
float inkLine(float d){ float w=u_lineWidth*SC*PX; return 1.-smoothstep(w*.5,w*.5+PX,abs(d)); }
float fillOf(float d){ return 1.-smoothstep(-PX*.6,PX*.6,d); }

// halftone dots pinned to the sky: rings of equal height, each holding as many dots as fit round it and every other
// ring staggered like a printed screen, so the dots stay round and one size and turning moves none of them.
// a screen grid scrolled with the view drifted at the edges. coverage 0..1 picks the dot size
vec3 HD;
float dots(float cover){
  float s=u_dotSize*.0021;
  float row=floor(asin(clamp(HD.y,-1.,1.))/s), rc=(row+.5)*s, n=max(floor(TAU*cos(rc)/s),1.), st=.5*mod(row,2.);
  float col=floor((atan(HD.z,HD.x)+PI)/TAU*n-st), ac=(col+.5+st)/n*TAU-PI;
  float r=angTo(HD,vec3(cos(rc)*cos(ac),sin(rc),cos(rc)*sin(ac)))/PX, rad=sqrt(clamp(cover,0.,1.))*s*.72/PX;
  return max(1.-smoothstep(rad-.7,rad+.7,r),smoothstep(.85,1.,cover));
}

// cartoon clouds: puffs along the top, a flat bottom, placed round the sky in two rings
float cloudSD(vec2 p, float l){
  float cnt=10., w=TAU/cnt, i0=floor(p.x/w), best=1.;
  float sz=.6+u_cloudSize*.012;
  for(int k=-1;k<=1;k++){
    float i=i0+float(k), im=mod(i,cnt);
    if(h11(im*1.7+l*19.)>u_cloudAmount*.01) continue;
    float h2=h11(im*5.3+l*7.), h3=h11(im*9.1+l*3.);
    float cx=(i+.5+(h2-.5)*.5)*w, W=(.08+.06*h3)*sz, base=.1+.2*l+(h2-.5)*.06;
    float dx=(p.x-cx)*cos(base), sd=1.;
    for(int j=0;j<5;j++){
      float fj=float(j), r=W*(.24+.22*sin(PI*(fj+.5)/5.)+.07*h11(fj+im*3.+l));
      sd=min(sd,length(vec2(dx,p.y-base)-vec2(W*(fj/4.-.5)*1.5,r*.45))-r);
    }
    best=min(best,max(sd,base-p.y));
  }
  return best;
}

float sparkle(vec2 p, float r){
  vec2 a=abs(p)/r;
  return pow(a.x,.7)+pow(a.y,.7)-1.;
}

vec3 sky(vec3 d){
  vec3 s=sunDir();
  float day=dayF(), dusk=duskF(), night=smoothstep(.5,.95,1.-day), y=max(d.y,0.);
  float az=atan(d.z,d.x), el=elev(d);
  HD=d;
  // misprint: the colour plate is printed a little off the ink plate
  vec2 mis=vec2(1.,-.6)*u_misprint*.04*SC*PX;
  vec3 ink=u_ink;

  vec3 top=mix(u_nightTop,u_dayTop,day), hor=mix(u_nightHorizon,u_dayHorizon,day);
  top=mix(top,u_sunsetTop,dusk*(.5+.5*mix(sunSide(d),.5,y*y)));
  hor=mix(hor,u_sunsetHorizon,dusk*(.3+.7*pow(sunSide(d),2.)));
  // two flat inks, the upper one laid over the lower as dots that grow up the sky
  float g=smoothstep(.02,.75,y+mis.y);
  vec3 c=mix(mix(hor,top,g),mix(hor,top,step(.5,dots(g))),u_halftone*.01);
  float lines=0.;

  if(u_starsOn>.5 && night>.01){
    vec2 q=vec2(az*cos(el),el)*18., ci=floor(q);
    for(int j=-1;j<=1;j++) for(int i=-1;i<=1;i++){
      vec2 cc=ci+vec2(float(i),float(j));
      if(h21(cc+4.)>u_starDensity*.005) continue;
      // the shape is drawn round the star's own direction: the grid's x shears with height away from one side of the sky
      vec2 qc=(cc+.5+(h22(cc)-.5)*.6)/18.;
      float sa=qc.x/max(cos(qc.y),.05);
      vec2 f=frame(d,vec3(cos(qc.y)*cos(sa),sin(qc.y),cos(qc.y)*sin(sa)));
      float r=(.012+.012*h21(cc+2.))*(.85+.15*sin(uTime*2.+h21(cc)*30.));
      float sd=sparkle(f,r)*r*.35;
      float vis=night*smoothstep(.04,.14,d.y);
      c=mix(c,u_starColor,fillOf(sd)*vis);
      lines=max(lines,inkLine(sd)*vis*.8);
    }
  }

  if(u_sunOn>.5){
    float R=radians(u_sunSize)*.5, a=angTo(d,s), up=smoothstep(-.1,.02,s.y);
    if(up>0. && dot(d,s)>.4){
      vec2 l=frame(d,s);
      // action lines: thin ink wedges round the sun, uneven lengths like they were drawn fast
      if(u_rays>.5){
        float th=atan(l.y,l.x)/TAU*u_rays, k=floor(th+.5), da=abs(th-k)*TAU/u_rays*a;
        float len=R*(1.35+.9*h11(k+7.)), wid=u_lineWidth*SC*PX*(1.-smoothstep(R*1.2,len,a))*1.2;
        lines=max(lines,(1.-smoothstep(wid*.5,wid*.5+PX,da))*step(R*1.2,a)*step(a,len)*up*max(day,dusk));
      }
      vec3 sc=mix(u_sunColor,mix(u_sunColor,vec3(1.,.45,.1),.6),dusk);
      c=mix(c,sc,fillOf(a-R)*up);
      lines=max(lines,inkLine(a-R)*up);
      // a shine dot on the disc, like a comic sun has
      c=mix(c,vec3(1.),fillOf(length(l-vec2(-.35,.35)*R)-R*.22)*up);
    }
    vec3 m=-s; float ma=angTo(d,m), mup=smoothstep(-.1,.02,m.y), MR=R*.75;
    if(mup>0. && dot(d,m)>.5){
      vec2 l=frame(d,m);
      float sd=max(length(l)-MR,MR*.85-length(l-vec2(MR*.75,MR*.2)));
      c=mix(c,u_moonColor,fillOf(sd)*mup);
      lines=max(lines,inkLine(sd)*mup);
      float cr=length(l-vec2(-.4,-.25)*MR)-MR*.16;
      c=mix(c,u_moonColor*.8,fillOf(cr)*fillOf(sd)*mup);
    }
  }

  if(u_cloudOn>.5 && el>0. && el<.8){
    for(int li=1;li>=0;li--){
      float l=float(li);
      vec2 p=vec2(az+uTime*u_wind*.0004*(1.+l*.5),el);
      float sd=cloudSD(p,l);
      if(sd>PX*8.) continue;
      float fd=cloudSD(p+mis,l);
      // the bottom of each cloud shaded with dots of the shade colour
      float base=.1+.2*l;
      vec3 cc=mix(u_cloudColor,u_cloudShade,step(.5,dots(.75-smoothstep(0.,.05,el-base))));
      cc=mix(cc*vec3(.45,.45,.7),cc,max(day,.2));
      cc=mix(cc,cc*vec3(1.,.8,.7)+u_sunsetHorizon*.2,dusk*.6);
      c=mix(c,cc,fillOf(fd));
      lines=max(lines*(1.-fillOf(sd)),inkLine(sd));
    }
  }

  c=mix(c,ink,lines);
  if(u_mono>.5){
    float lum=dot(c,vec3(.3,.59,.11));
    c=mix(ink,vec3(1.),step(.5,1.-dots(1.-lum))*.97*(1.-lines));
  }
  return c*u_paper;
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
