#version 150

// Synthwave sky. Generated by tools/skylab/port.js from tools/skylab/styles/synth.js, edit that and re-run.
// Members after FogCol are the style's settings in the lab's order, PaintedSky writes them in the same order.

in vec2 texCoord;
out vec4 fragColor;

layout(std140) uniform SkyParams {
    mat4 InvViewProj;
    mat4 ViewProj;
    vec4 ResTime;
    vec4 SunDay;
    vec4 Forward;
    vec4 FogCol;
    vec4 c_dayTop;
    vec4 c_dayHorizon;
    vec4 c_duskHorizon;
    vec4 c_nightTop;
    float u_nightLock;
    float u_horizonGlow;
    float u_motion;
    float u_sunOn;
    float u_sunRing;
    float u_sunSize;
    float u_stripes;
    vec4 c_sunTop;
    vec4 c_sunBottom;
    float u_planetOn;
    float u_planetSize;
    vec4 c_planetA;
    float u_planetRings;
    float u_planetWire;
    float u_mtnOn;
    float u_mtnHeight;
    float u_mtnWire;
    vec4 c_mtnLine;
    float u_cloudOn;
    float u_cloudPuffy;
    float u_cloudAmount;
    vec4 c_cloudColor;
    vec4 c_cloudRim;
    float u_starsOn;
    float u_starDensity;
    float u_meteors;
    float u_domeOn;
    float u_domeLines;
    vec4 c_domeColor;
    float u_pulses;
    vec4 c_pulseColor;
    float u_dataRain;
    float u_crtOn;
    float u_scanlines;
};
#define u_dayTop c_dayTop.rgb
#define u_dayHorizon c_dayHorizon.rgb
#define u_duskHorizon c_duskHorizon.rgb
#define u_nightTop c_nightTop.rgb
#define u_sunTop c_sunTop.rgb
#define u_sunBottom c_sunBottom.rgb
#define u_planetA c_planetA.rgb
#define u_mtnLine c_mtnLine.rgb
#define u_cloudColor c_cloudColor.rgb
#define u_cloudRim c_cloudRim.rgb
#define u_domeColor c_domeColor.rgb
#define u_pulseColor c_pulseColor.rgb

#define uRes ResTime.xy
#define uTime ResTime.z
#define uDay SunDay.w
#define PI 3.14159265
#define TAU 6.28318531
float PX, SC, uYaw, uPitch; vec2 FC; vec3 FWD;
float h11(float p){ return fract(sin(p*127.1+.31)*43758.5453); }
float h21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec2 h22(vec2 p){ return fract(sin(vec2(dot(p,vec2(127.1,311.7)),dot(p,vec2(269.5,183.3))))*43758.5453); }
float vnoise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h21(i),h21(i+vec2(1.,0.)),f.x), mix(h21(i+vec2(0.,1.)),h21(i+vec2(1.,1.)),f.x), f.y); }
float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.1,9.2); a*=.5; } return s/.96875; }
// tilted toward +z like the lab's, vanilla's goes straight overhead and cross(sun, up) is zero there
vec3 sunDir(){ return normalize(SunDay.xyz+vec3(0.,0.,.25)); }
float dayF(){ return smoothstep(-.15,.2,sunDir().y); }
float duskF(){ float y=sunDir().y; return exp(-y*y*28.); }
float elev(vec3 d){ return asin(clamp(d.y,-1.,1.)); }
float angTo(vec3 d, vec3 s){ return acos(clamp(dot(d,s),-1.,1.)); }
float sunSide(vec3 d){ vec3 s=sunDir(); return .5+.5*dot(normalize(d.xz+1e-5), normalize(s.xz+1e-5)); }
float stars(vec3 d, float dens){
  float el=elev(d);
  vec2 q=vec2(atan(d.z,d.x)*cos(el), el)*55.;
  vec2 c=floor(q), f=fract(q)-.5-(h22(c+7.)-.5)*.6;
  return step(1.-dens,h21(c))*(1.-smoothstep(.04,.1+.06*h21(c+3.),length(f)))*(.4+.6*h21(c+5.));
}
// the lab's camera helpers on the game's camera. its screen is mirrored next to the lab's, so right is worked out
// rather than copied, and CAMF is the focal length in screen heights from the real fov
#define CAMF (.5/ResTime.w)
vec3 camRight(){ return normalize(cross(FWD,vec3(0.,1.,0.))); }
vec3 camUp(){ return cross(camRight(),FWD); }
vec3 camRay(vec2 fc){
  vec2 ndc=fc/uRes*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  return normalize(pf.xyz/pf.w-pn.xyz/pn.w);
}
vec2 camScreen(vec3 w, out float front){
  vec4 c=ViewProj*vec4(w,0.);
  front=c.w;
  return (c.xy/max(c.w,1e-3)*.5+.5)*uRes;
}
#define SHEETX Forward.w
// a screen pattern that turns with the sky: FC scrolled by how far the sky has turned across the middle of the screen
// (Forward.w, PaintedSky adds it up frame to frame) and by pitch. lines stay straight on screen and the sheet keeps pace with the sky as you look round
vec2 sheet(){
  vec3 yawDir=vec3(cos(uYaw),0.,-sin(uYaw)), pitchDir=vec3(-sin(uPitch)*sin(uYaw),cos(uPitch),-sin(uPitch)*cos(uYaw));
  return FC+vec2(dot(yawDir,camRight())<0.?-SHEETX:SHEETX, dot(pitchDir,camUp())<0.?-uPitch:uPitch)/PX;
}

float rad(float deg){ return deg*PI/180.; }
float dayS(){ return dayF()*(1.-u_nightLock*.01); }
float spd(){ return .2+u_motion*.02; }
// screen-ish coords around a direction s: x across, y toward world up
vec2 frame(vec3 d, vec3 s){ vec3 e1=normalize(cross(s,vec3(0.,1.,0.))), e2=cross(e1,s); return vec2(dot(d,e1),dot(d,e2)); }

float meteor(vec3 d, float el, float az){
  float N=u_meteors; if(N<.5) return 0.;
  float t=uTime*N/60., k=floor(t), prog=fract(t)*60./N/.9;
  if(prog>1.) return 0.;
  // anywhere round the sky: placed where you looked, a meteor in flight turned with you
  float a0=h11(k)*TAU;
  float e0=.4+.5*h11(k+1.);
  vec2 v=normalize(vec2(h11(k+2.)>.5?1.:-1.,-.5-.4*h11(k+3.)));
  vec2 p=vec2((mod(az-a0+PI,TAU)-PI)*cos(el),el-e0);
  float along=dot(p,v), across=dot(p,vec2(-v.y,v.x)), head=prog*.35;
  return smoothstep(head-.14,head,along)*step(along,head)*exp(-abs(across)/(PX*1.3))*(1.-prog*prog);
}

float rain(float el, float az){
  float x=(az+PI)/TAU*300., ci=floor(x), fx=fract(x);
  float y=el*45.+uTime*(.5+h11(ci)*1.5)*spd()*2.;
  float cell=floor(y), fy=fract(y);
  float glyph=step(.4,h21(vec2(ci,cell)))*step(.2,fx)*step(fx,.8)*step(.15,fy)*step(fy,.85);
  return glyph*pow(1.-fract(y/22.+h11(ci+5.)),5.)*step(.35,h11(ci+9.))*smoothstep(.03,.2,el)*smoothstep(1.2,.8,el);
}

vec3 dome(float el, float az, vec3 c){
  float NL=floor(u_domeLines), NA=floor(u_domeLines*.38);
  float lon=az/TAU*NL, lat=el/(PI*.5)*NA;
  float dlon=abs(fract(lon+.5)-.5)*TAU/NL*cos(el), dlat=abs(fract(lat+.5)-.5)*(PI*.5)/NA;
  float wl=(1.-smoothstep(PX*.5,PX*1.8,dlon))*smoothstep(1.45,1.15,el);
  float wa=(1.-smoothstep(PX*.5,PX*1.8,dlat))*step(0.,el);
  c+=u_domeColor*max(wl,wa)*.55*(.4+.6*(1.-el/1.57));
  float il=floor(lon+.5);
  float pp=fract(uTime*.05*spd()+h11(il));
  float pl=exp(-abs(el/(PI*.5)-pp)*45.)*wl*step(.4,h11(il+2.));
  float ia=floor(lat+.5), dir=h11(ia+9.)>.5?1.:-1.;
  float pa=fract(uTime*.025*spd()*dir+h11(ia));
  float dx=abs(fract(az/TAU+.5)-pa); dx=min(dx,1.-dx);
  float pa2=exp(-dx*70.)*wa*step(.3,h11(ia+4.));
  c+=u_pulseColor*(pl+pa2)*1.8*u_pulses*.01;
  c+=mix(u_domeColor,vec3(.6,1.,.7),.5)*rain(el,az)*u_dataRain*.006;
  return c;
}

void sunStriped(vec3 d, vec3 s, float R, inout vec3 c){
  float ang=angTo(d,s), g=u_horizonGlow*.01+.3;
  c+=mix(u_sunBottom,u_sunTop,.5)*(exp(-ang*4.)*.22+exp(-ang*14.)*.35)*g;
  if(dot(d,s)<.5) return;
  float t=frame(d,s).y/R, s01=-t, N=u_stripes;
  vec3 sc=mix(u_sunBottom,u_sunTop,smoothstep(-.9,.8,t));
  float band=fract(s01*N*.5+uTime*.03*spd());
  float gw=clamp((s01+.25)*.55,0.,.7)*step(-.25,s01)*step(.5,N);
  float aa=PX*N*.25/R+.004;
  float gap=smoothstep(.5-gw*.5-aa,.5-gw*.5+aa,abs(band-.5))*step(.001,gw);
  float disc=1.-smoothstep(R-PX,R+PX,ang);
  // retro screen splits the bright edge into red and blue
  float f=u_crtOn*2.5*PX*SC;
  float outer=(1.-smoothstep(R-PX,R+PX,ang-f))-disc, inner=disc-(1.-smoothstep(R-PX,R+PX,ang+f));
  c=mix(c,sc*1.1,disc*(1.-gap));
  c+=vec3(1.,.1,.3)*outer*.7+vec3(.1,.5,1.)*inner*.5;
}

void sunRing(vec3 d, vec3 s, float R, inout vec3 c){
  float ang=angTo(d,s);
  c+=u_sunTop*exp(-ang*10.)*.3*(u_horizonGlow*.01+.3);
  if(dot(d,s)<.5) return;
  vec2 l=frame(d,s); float th=atan(l.y,l.x);
  float r1=1.-smoothstep(PX*.8,PX*2.,abs(ang-R));
  float r2=(1.-smoothstep(PX*.8,PX*2.,abs(ang-R*.62)))*step(.5,fract(th/TAU*6.+uTime*.02*spd()));
  float tk=step(R*1.12,ang)*step(ang,R*1.3)*step(abs(fract(th/TAU*48.-uTime*.01)-.5),.14);
  float core=1.-smoothstep(R*.3-PX,R*.3+PX,ang);
  c+=mix(u_sunTop,vec3(1.),.35)*(r1+r2*.8+tk*.6)+mix(u_sunBottom,vec3(1.),.6)*core;
}

void planet(vec3 d, vec3 p, float R, float vis, inout vec3 c){
  if(vis<.01 || dot(d,p)<.5) return;
  vec2 l=frame(d,p); float ang=angTo(d,p);
  float disc=1.-smoothstep(R-PX,R+PX,ang);
  vec3 B=mix(u_planetA,u_sunBottom,.45);
  c+=mix(u_planetA,B,.5)*exp(-max(ang-R,0.)*25.)*.25*vis;
  if(u_planetWire>.5){
    vec2 q=l/R; float r2=dot(q,q);
    if(r2<1.){
      float z=sqrt(1.-r2), clat=sqrt(max(1.-q.y*q.y,0.));
      float lat=asin(clamp(q.y,-1.,1.)), lon=atan(q.x,z)+uTime*.25;
      float dl=abs(fract(lat/PI*8.+.5)-.5)*PI/8.*R*clat;
      float dn=abs(fract(lon/TAU*12.+.5)-.5)*TAU/12.*R*z;
      float ln=max(1.-smoothstep(PX*.6,PX*1.6,dl),1.-smoothstep(PX*.6,PX*1.6,dn));
      c=mix(c,c*.25,vis*.85);
      c+=u_planetA*ln*vis*(.45+.55*z);
    }
    c+=u_planetA*(1.-smoothstep(PX*.8,PX*2.2,abs(ang-R)))*vis;
    return;
  }
  vec2 r=vec2(l.x*.94+l.y*.34,-l.x*.34+l.y*.94);
  float rr=length(vec2(r.x,r.y/.22));
  float ring=u_planetRings*(1.-smoothstep(R*.4-PX,R*.4+PX,abs(rr-R*1.8)))*(.6+.4*sin(rr/R*38.));
  float bands=.5+.5*sin(r.y/R*9.+vnoise(r/R*3.+7.)*2.5);
  vec3 pc=mix(u_planetA,B,bands*.7+.15)*(.5+.5*smoothstep(-R,R*.8,r.y+r.x*.3));
  pc+=B*smoothstep(R*.7,R,ang)*.5;
  vec3 rc=mix(B,vec3(1.),.35);
  c=mix(c,rc,ring*vis*.85*(1.-disc));
  c=mix(c,pc,disc*vis);
  c=mix(c,rc,ring*vis*.85*disc*step(r.y,0.));
}

// thin bands like the clouds on an 80s poster, lit along the bottom edge
void streaks(vec3 d, float el, float az, float day, float dusk, inout vec3 c){
  if(el<0. || el>.65) return;
  vec2 off=vec2(26.,-21.);
  vec2 p=vec2(cos(az),sin(az))*1.6+off*el+vec2(uTime*.004*spd(),0.);
  float th=.72-u_cloudAmount*.0025;
  float band=smoothstep(.012,.05,el)*smoothstep(.62,.35,el);
  float n=fbm(p), nb=fbm(p-off*.012);
  float m=smoothstep(th,th+.03,n)*band;
  float rim=m*(1.-smoothstep(th,th+.03,nb));
  c=mix(c,u_cloudColor*mix(.45,1.,max(day,dusk)),m*.92);
  c+=u_cloudRim*rim*(.35+.9*sunSide(d)*max(day,dusk));
}

// soft cel-shaded puffs in three flat tones
void puffs(vec3 d, vec3 S, float day, float dusk, inout vec3 c){
  if(d.y<0.) return;
  vec2 p=d.xz/(d.y+.14)*.32+vec2(uTime*.003*spd(),0.);
  float th=.72-u_cloudAmount*.0025;
  float n=fbm(p), m=smoothstep(th,th+.025,n)*smoothstep(0.,.08,d.y);
  if(m<.001) return;
  float tone=clamp((fbm(p+normalize(S.xz+1e-5)*.06)-n)*9.+.5,0.,1.);
  vec3 lit=mix(vec3(1.),u_cloudColor,.25), sh=mix(u_cloudColor,u_cloudRim,.55);
  vec3 cc=tone<.4?lit:(tone<.7?mix(lit,sh,.5):sh);
  c=mix(c,cc*mix(.35,1.,max(day,dusk*.8)),m);
}

float mtnH(float az){
  vec2 q=vec2(cos(az),sin(az));
  float r=1.-abs(vnoise(q*2.6+3.3)*2.-1.), r2=1.-abs(vnoise(q*6.1+7.1)*2.-1.), n=vnoise(q*14.+1.9);
  float env=.45+.55*vnoise(q*1.2+11.);
  return rad(u_mtnHeight)*(.1+.9*pow(r*r*.65+r2*.27+n*.08,1.5)*env);
}
void mountains(float el, float az, inout vec3 c){
  if(u_mtnOn<.5) return;
  float h=mtnH(az);
  if(el>h+.08) return;
  float da=.004, dh=(mtnH(az+da)-mtnH(az-da))/(2.*da), ce=cos(el);
  float dist=(h-el)/sqrt(1.+dh*dh/(ce*ce));
  c+=u_mtnLine*exp(min(dist,0.)/(PX*14.))*.3*(u_horizonGlow*.01+.2)*step(dist,0.);
  if(dist>0.){
    vec3 fill=mix(mix(u_nightTop*.7,c,.12),c*.6,dayS()*.55);
    if(u_mtnWire>.5){
      float t=el/max(h,1e-3), N=7.;
      float dl=abs(fract(t*N+.5)-.5)/N*h, K=90.;
      float dv=abs(fract(az*K/TAU+.5)-.5)*TAU/K*ce;
      float wire=max((1.-smoothstep(PX*.45,PX*1.4,dl))*.6,(1.-smoothstep(PX*.45,PX*1.4,dv))*.3);
      fill+=u_mtnLine*wire*(.2+.8*clamp(t,0.,1.));
    }
    c=fill;
  }
  c=mix(c,mix(u_mtnLine,vec3(1.),.3),1.-smoothstep(PX*.7,PX*2.,abs(dist)));
}

vec3 crt(vec3 c){
  if(u_crtOn<.5) return c;
  c*=1.-u_scanlines*.0035*(.5-.5*sin(FC.y*PI/(1.5*SC)));
  c*=1.+u_scanlines*.0006*sin(FC.y/uRes.y*TAU*1.5-uTime*1.2);
  vec2 v=(FC-.5*uRes)/uRes.y;
  return c*(1.-.6*dot(v,v)*u_scanlines*.01);
}

vec3 sky(vec3 d){
  vec3 S=sunDir();
  float day=dayS(), dusk=duskF()*(1.-u_nightLock*.007);
  float el=elev(d), az=atan(d.z,d.x), y=max(d.y,0.);
  vec3 nightHor=mix(u_nightTop,u_duskHorizon,.35);
  vec3 top=mix(u_nightTop,u_dayTop,day), hor=mix(nightHor,u_dayHorizon,day);
  hor=mix(hor,u_duskHorizon,dusk*.85);
  top=mix(top,mix(u_nightTop,u_duskHorizon,.35),dusk*.5);
  vec3 c=mix(hor,top,pow(y,.45));
  c+=mix(u_duskHorizon,u_mtnLine,.3)*exp(-y*12.)*(.35+.6*dusk*sunSide(d))*u_horizonGlow*.01;
  if(u_starsOn>.5){
    float n=smoothstep(.5,.95,1.-day);
    c+=stars(d,u_starDensity*.001)*n*smoothstep(.03,.25,y);
    c+=meteor(d,el,az)*n;
  }
  if(u_domeOn>.5) c=dome(el,az,c);
  float R=rad(u_sunSize)*.5;
  if(u_sunOn>.5){ if(u_sunRing>.5) sunRing(d,S,R,c); else sunStriped(d,S,R,c); }
  if(u_planetOn>.5) planet(d,-S,rad(u_planetSize)*.5,smoothstep(-.05,.1,-S.y),c);
  if(u_cloudOn>.5){ if(u_cloudPuffy>.5) puffs(d,S,day,dusk,c); else streaks(d,el,az,day,dusk,c); }
  mountains(el,az,c);
  return crt(c);
}

void main(){
  FC=gl_FragCoord.xy;
  vec2 ndc=texCoord*2.-1.;
  vec4 pn=InvViewProj*vec4(ndc,-1.,1.), pf=InvViewProj*vec4(ndc,1.,1.);
  vec3 d=normalize(pf.xyz/pf.w-pn.xyz/pn.w);
  // a sky only: under the horizon is the colour terrain fogs into, as under vanilla's, and the style does no work there
  if(d.y<-.04){ fragColor=vec4(FogCol.rgb,1.); return; }
  PX=2.*ResTime.w/uRes.y;
  SC=max(1.,uRes.y/650.);
  FWD=normalize(Forward.xyz);
  uYaw=atan(FWD.x,FWD.z);
  uPitch=asin(clamp(FWD.y,-1.,1.));
  vec3 c=clamp(sky(d),0.,1.);
  fragColor=vec4(mix(c,FogCol.rgb,smoothstep(0.,-.04,d.y)),1.);
}
